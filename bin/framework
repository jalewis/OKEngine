#!/usr/bin/env python3
"""Executable launcher for the OKEngine framework CLI."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> None:
    # resolve() follows a PATH symlink back to the engine checkout.
    command = Path(__file__).resolve().parents[1] / "scripts" / "framework.py"
    os.execv(sys.executable, [sys.executable, str(command), *sys.argv[1:]])


if __name__ == "__main__":
    main()
