+
+def _discover_cron_mcp_tools(enabled_toolsets: list[str] | None) -> list[str]:
+    """Initialize only MCP servers admitted by this cron job's allowlist."""
+    from tools.mcp_tool import _load_mcp_config, register_mcp_servers
+
+    servers = _load_mcp_config()
+    if enabled_toolsets is None:
+        return register_mcp_servers(servers)
+    allowed = set(enabled_toolsets)
+    selected = {name: value for name, value in servers.items() if name in allowed}
+    omitted = len(servers) - len(selected)
+    if omitted:
+        logger.info(
+            "Cron MCP scope: initializing %d of %d configured server(s)",
+            len(selected), len(servers),
+        )
+    return register_mcp_servers(selected)
+
+
+def _require_explicit_cron_tool_surface(job: dict, enabled_toolsets: list[str] | None) -> None:
+    """Fail closed when a cron lane omitted its per-job allowlist."""
+    if enabled_toolsets is None:
+        raise RuntimeError(
+            f"Job '{job.get('name') or job.get('id')}' has enabled_toolsets=null; "
+            "cron agent tool surfaces must be explicit"
+        )
+
+
+def _validate_cron_mcp_surface(job: dict, enabled_toolsets: list[str],
+                               mcp_tools: list[str]) -> None:
+    required = [name for name in enabled_toolsets if name.startswith("okengine")]
+    canonical = [name for name in mcp_tools if str(name).startswith("mcp__")]
+    logger.info(
+        "Job '%s': tool surface — %d MCP offered (%s)",
+        job.get("name") or job.get("id"), len(canonical),
+        ", ".join(canonical) if canonical else "NONE",
+    )
+    if required and not canonical:
+        raise RuntimeError(
+            f"Job '{job.get('name') or job.get('id')}' requires MCP server(s) "
+            f"{required}, but zero canonical MCP tools were offered"
+        )
+
