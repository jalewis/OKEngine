@@ -0,0 +1,90 @@
+"""Reject a CWD-confused write before it creates a rogue nested workspace."""
+
+import json
+from unittest.mock import create_autospec
+
+import tools.file_tools as ft
+import tools.terminal_tool as terminal_tool
+from tools.file_operations import ShellFileOperations
+from tools.file_operations_common import WriteResult
+from tools.environments.local import LocalEnvironment
+
+
+def _write_from_workspace(monkeypatch, tmp_path, relative_path):
+    workspace = tmp_path / "vault" / "wiki"
+    workspace.mkdir(parents=True)
+    decoy = tmp_path / "decoy"
+    decoy.mkdir()
+    monkeypatch.chdir(decoy)
+    monkeypatch.setattr(terminal_tool, "_session_cwd", {})
+    terminal_tool.record_session_cwd("doubled-fixture", str(workspace))
+    ops = create_autospec(ShellFileOperations, instance=True)
+    ops.write_file.return_value = WriteResult(bytes_written=5, verified=True)
+    monkeypatch.setattr(ft, "_get_file_ops", lambda _task: ops)
+    result = json.loads(ft.write_file_tool(relative_path, "hello", task_id="doubled-fixture"))
+    return workspace, result, ops
+
+
+def test_agent_relative_doubled_segment_is_denied_before_write(monkeypatch, tmp_path):
+    workspace, result, ops = _write_from_workspace(monkeypatch, tmp_path, "wiki/index.md")
+    assert "doubled directory segment" in result.get("error", "")
+    assert "wiki/wiki" in result["error"]
+    ops.write_file.assert_not_called()
+    assert not (workspace / "wiki" / "index.md").exists()
+
+
+def test_normal_sibling_path_is_written_at_agent_cwd_not_process_cwd(monkeypatch, tmp_path):
+    workspace, result, ops = _write_from_workspace(monkeypatch, tmp_path, "reports/index.md")
+    assert "error" not in result
+    ops.write_file.assert_called_once_with(str(workspace / "reports" / "index.md"), "hello")
+
+
+def test_read_file_status_text_cannot_be_persisted_as_file_content(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hermes"))
+    monkeypatch.setenv("HERMES_WRITE_SAFE_ROOT", str(tmp_path))
+    monkeypatch.delenv("WIKI_PATH", raising=False)
+    task_id = f"status-display-{tmp_path.name}"
+    target = tmp_path / "status-copy.txt"
+    ops = ShellFileOperations(LocalEnvironment(cwd=str(tmp_path), timeout=5))
+    with ft._file_ops_lock:
+        ft._file_ops_cache[task_id] = ops
+
+    try:
+        result = json.loads(ft.write_file_tool(
+            str(target), ft._READ_DEDUP_STATUS_MESSAGE, task_id=task_id,
+        ))
+        assert "internal read_file display text" in result.get("error", ""), result
+        assert not target.exists(), "client-visible denial must precede any backend write"
+    finally:
+        ft.clear_file_ops_cache(task_id)
+
+
+def test_successful_file_write_is_visible_on_late_client_read(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hermes"))
+    monkeypatch.setenv("HERMES_WRITE_SAFE_ROOT", str(tmp_path))
+    monkeypatch.delenv("WIKI_PATH", raising=False)
+    task_id = f"write-read-{tmp_path.name}"
+    target = tmp_path / "durable.txt"
+    target.write_text("before\n", encoding="utf-8")
+    ops = ShellFileOperations(LocalEnvironment(cwd=str(tmp_path), timeout=5))
+    with ft._file_ops_lock:
+        ft._file_ops_cache[task_id] = ops
+
+    try:
+        before = json.loads(ft.read_file_tool(str(target), task_id=task_id))
+        assert "before" in before.get("content", ""), before
+
+        written = json.loads(ft.write_file_tool(
+            str(target), "after\n", task_id=task_id, session_id="disposable-session",
+        ))
+        assert written.get("error") is None, written
+        assert written.get("verified") is True, written
+        assert written.get("resolved_path") == str(target), written
+        assert written.get("files_modified") == [str(target)], written
+
+        after = json.loads(ft.read_file_tool(str(target), task_id=task_id))
+        assert "after" in after.get("content", ""), after
+        assert "before" not in after.get("content", ""), after
+        assert target.read_bytes() == b"after\n", "tool response must reflect durable file bytes"
+    finally:
+        ft.clear_file_ops_cache(task_id)
