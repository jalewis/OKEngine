+def _doubled_path_segment(resolved_path: str) -> str | None:
+    """Find adjacent equal directory names in the task-resolved write path.
+
+    The path is already anchored to the agent's task cwd. Do not resolve it
+    again against the host: a container path or symlink may live elsewhere.
+    """
+    parts = Path(resolved_path).parts
+    for left, right in zip(parts, parts[1:]):
+        if left not in ("/", ".", "..") and not left.startswith(".") and left == right:
+            return f"{left}/{right}"
+    return None
+
