+    @staticmethod
+    def _okengine_api_inference_default(runtime_kwargs: Dict[str, Any], model: str) -> str:
+        """Resolve the API chat default as one model/provider/runtime tuple.
+
+        Cron/bulk gateway defaults remain untouched. A requested API override
+        cannot silently fall back to that bulk route on auth/config failure.
+        """
+        api_model = (os.getenv("API_SERVER_INFERENCE_MODEL") or "").strip()
+        api_provider = (os.getenv("API_SERVER_INFERENCE_PROVIDER") or "").strip()
+        if not api_model and not api_provider:
+            return model
+        provider = api_provider or _clean_request_string(runtime_kwargs.get("requested_provider")) \
+            or _clean_request_string(runtime_kwargs.get("provider"))
+        if not provider:
+            raise _ProviderAuthResolutionError(
+                "API_SERVER_INFERENCE_MODEL requires a resolvable API provider")
+        from hermes_cli.runtime_provider import (
+            resolve_runtime_provider, format_runtime_provider_error, is_routable_provider)
+        from gateway.run import _runtime_agent_kwargs
+        if api_provider and api_provider.lower() not in ("auto", "custom") and not is_routable_provider(api_provider):
+            raise _ProviderAuthResolutionError(
+                f"API server inference provider {api_provider!r} is not a configured route")
+        try:
+            resolved = resolve_runtime_provider(requested=provider, target_model=api_model or None)
+        except Exception as exc:
+            raise _ProviderAuthResolutionError(format_runtime_provider_error(exc)) from exc
+        if not isinstance(resolved, dict) or not _clean_request_string(resolved.get("provider")):
+            raise _ProviderAuthResolutionError(
+                f"API server inference provider {provider!r} resolved no usable runtime")
+        if api_provider and resolved.get("provider") == "openrouter" and api_provider.lower() != "openrouter":
+            raise _ProviderAuthResolutionError(
+                f"API server inference provider {api_provider!r} unexpectedly fell back to OpenRouter")
+        if api_provider and _clean_request_string(resolved.get("requested_provider")) not in (None, api_provider):
+            raise _ProviderAuthResolutionError(
+                f"API server inference provider {api_provider!r} resolved an unexpected route")
+        if api_provider and not api_model:
+            with suppress(Exception):
+                from hermes_cli.models import get_default_model_for_provider
+                api_model = _clean_request_string(get_default_model_for_provider(api_provider)) or ""
+            api_model = api_model or _clean_request_string(resolved.get("model")) or ""
+            if not api_model:
+                raise _ProviderAuthResolutionError(
+                    "API_SERVER_INFERENCE_PROVIDER requires API_SERVER_INFERENCE_MODEL "
+                    "or a provider default model")
+        # Replace, do not merely overlay non-null values: a different provider
+        # must not inherit the bulk route's base_url, key, request body, or mode.
+        runtime_kwargs.update(_runtime_agent_kwargs(resolved))
+        if api_provider and not runtime_kwargs.get("requested_provider"):
+            runtime_kwargs["requested_provider"] = api_provider
+        capabilities = resolved.get("capabilities")
+        runtime_kwargs["capabilities"] = (
+            {k: v for k, v in capabilities.items() if isinstance(k, str) and isinstance(v, bool)}
+            if isinstance(capabilities, dict) else {})
+        return api_model or model
+
