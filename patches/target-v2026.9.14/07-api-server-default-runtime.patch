diff --git a/tests/gateway/test_okengine_api_server_default_model.py b/tests/gateway/test_okengine_api_server_default_model.py
new file mode 100644
index 000000000..fcd6141d4
--- /dev/null
+++ b/tests/gateway/test_okengine_api_server_default_model.py
@@ -0,0 +1,162 @@
+"""API chat defaults can differ from bulk gateway defaults without stale credentials."""
+
+from unittest.mock import create_autospec
+
+import pytest
+
+import run_agent
+from gateway.config import PlatformConfig
+from gateway.platforms.api_server import APIServerAdapter, _ProviderAuthResolutionError
+from hermes_cli.runtime_provider import resolve_runtime_provider, is_routable_provider
+
+
+def _disposable_adapter(monkeypatch):
+    captured = []
+    calls = []
+    real_agent_class = run_agent.AIAgent
+    agent = create_autospec(real_agent_class, instance=True)
+
+    def construct(**kwargs):
+        captured.append(kwargs)
+        agent.model = kwargs["model"]
+        agent.provider = kwargs["provider"]
+        return agent
+
+    monkeypatch.setattr(run_agent, "AIAgent", create_autospec(real_agent_class, side_effect=construct))
+    monkeypatch.setattr("gateway.run._resolve_runtime_agent_kwargs", lambda: {
+        "provider": "local", "requested_provider": "local", "base_url": "http://local.test/v1",
+        "api_key": "local-key", "api_mode": "chat_completions", "command": None,
+        "args": [], "credential_pool": None, "request_overrides": {"temperature": 0.1},
+        "capabilities": {"vision": True},
+    })
+    monkeypatch.setattr("gateway.run._resolve_gateway_model", lambda: "bulk-model")
+    monkeypatch.setattr("gateway.run._load_gateway_config", lambda: {})
+    monkeypatch.setattr("gateway.run._checkpoint_agent_kwargs", lambda _cfg: {})
+    monkeypatch.setattr("gateway.run._current_max_iterations", lambda: 10)
+    monkeypatch.setattr("gateway.run.GatewayRunner._load_reasoning_config",
+                        staticmethod(lambda _model="": None))
+    monkeypatch.setattr("gateway.run.GatewayRunner._load_fallback_model", staticmethod(lambda: None))
+    monkeypatch.setattr("hermes_cli.tools_config._get_platform_tools", lambda *_args: set())
+
+    def resolve(*, requested=None, target_model=None, **_kwargs):
+        calls.append((requested, target_model))
+        if requested == "broken":
+            raise RuntimeError("provider not configured")
+        return {
+            "provider": requested, "requested_provider": requested,
+            "base_url": f"https://{requested}.test/v1" if requested != "local" else "http://local.test/v1",
+            "api_key": f"{requested}-key", "api_mode": "chat_completions",
+            "command": None, "args": [], "credential_pool": None,
+            "request_overrides": None, "capabilities": {},
+        }
+
+    monkeypatch.setattr("hermes_cli.runtime_provider.resolve_runtime_provider",
+                        create_autospec(resolve_runtime_provider, side_effect=resolve))
+    monkeypatch.setattr("hermes_cli.runtime_provider.is_routable_provider",
+                        create_autospec(is_routable_provider, side_effect=lambda _name: True))
+    adapter = APIServerAdapter(PlatformConfig(enabled=True))
+    monkeypatch.setattr(adapter, "_ensure_session_db", lambda: None)
+    return adapter, captured, calls
+
+
+def test_model_only_override_keeps_provider_but_changes_api_default(monkeypatch):
+    adapter, captured, calls = _disposable_adapter(monkeypatch)
+    monkeypatch.setenv("API_SERVER_INFERENCE_MODEL", "interactive-model")
+    monkeypatch.delenv("API_SERVER_INFERENCE_PROVIDER", raising=False)
+    adapter._create_agent(session_id="api-chat")
+    assert captured[0]["model"] == "interactive-model"
+    assert captured[0]["provider"] == "local"
+    assert calls == [("local", "interactive-model")]
+
+
+def test_provider_and_model_override_replace_full_runtime_tuple(monkeypatch):
+    adapter, captured, calls = _disposable_adapter(monkeypatch)
+    monkeypatch.setenv("API_SERVER_INFERENCE_PROVIDER", "deepseek")
+    monkeypatch.setenv("API_SERVER_INFERENCE_MODEL", "deepseek-flash")
+    adapter._create_agent(session_id="api-chat")
+    kwargs = captured[0]
+    assert kwargs["model"] == "deepseek-flash"
+    assert kwargs["provider"] == kwargs["requested_provider"] == "deepseek"
+    assert kwargs["base_url"] == "https://deepseek.test/v1"
+    assert kwargs["api_key"] == "deepseek-key"
+    assert kwargs["request_overrides"] is None and kwargs["capabilities"] == {}
+    assert calls == [("deepseek", "deepseek-flash")]
+
+
+def test_explicit_provider_resolution_failure_never_falls_back_to_bulk(monkeypatch):
+    adapter, captured, _calls = _disposable_adapter(monkeypatch)
+    monkeypatch.setenv("API_SERVER_INFERENCE_PROVIDER", "broken")
+    monkeypatch.setenv("API_SERVER_INFERENCE_MODEL", "interactive-model")
+    with pytest.raises(_ProviderAuthResolutionError, match="provider not configured"):
+        adapter._create_agent(session_id="api-chat")
+    assert not captured
+
+
+def test_provider_only_override_uses_its_own_default_model(monkeypatch):
+    adapter, captured, calls = _disposable_adapter(monkeypatch)
+    monkeypatch.setenv("API_SERVER_INFERENCE_PROVIDER", "deepseek")
+    monkeypatch.delenv("API_SERVER_INFERENCE_MODEL", raising=False)
+    monkeypatch.setattr("hermes_cli.models.get_default_model_for_provider",
+                        lambda name: "deepseek-flash" if name == "deepseek" else None)
+    adapter._create_agent(session_id="api-chat")
+    assert captured[0]["model"] == "deepseek-flash"
+    assert captured[0]["provider"] == "deepseek"
+    assert calls == [("deepseek", None)]
+
+
+def test_provider_only_without_default_model_is_refused(monkeypatch):
+    adapter, captured, _calls = _disposable_adapter(monkeypatch)
+    monkeypatch.setenv("API_SERVER_INFERENCE_PROVIDER", "deepseek")
+    monkeypatch.delenv("API_SERVER_INFERENCE_MODEL", raising=False)
+    monkeypatch.setattr("hermes_cli.models.get_default_model_for_provider", lambda _name: None)
+    with pytest.raises(_ProviderAuthResolutionError, match="requires API_SERVER_INFERENCE_MODEL"):
+        adapter._create_agent(session_id="api-chat")
+    assert not captured
+
+
+def test_per_request_provider_and_model_win_over_api_default(monkeypatch):
+    adapter, captured, calls = _disposable_adapter(monkeypatch)
+    monkeypatch.setenv("API_SERVER_INFERENCE_PROVIDER", "deepseek")
+    monkeypatch.setenv("API_SERVER_INFERENCE_MODEL", "deepseek-flash")
+    adapter._create_agent(session_id="api-chat", requested_model="other-chat",
+                          requested_provider="other")
+    assert captured[0]["model"] == "other-chat"
+    assert captured[0]["provider"] == "other"
+    assert calls[0] == ("deepseek", "deepseek-flash")
+    assert calls[1] == ("other", "other-chat")
+
+
+def test_unconfigured_api_default_preserves_bulk_runtime(monkeypatch):
+    adapter, captured, calls = _disposable_adapter(monkeypatch)
+    monkeypatch.delenv("API_SERVER_INFERENCE_PROVIDER", raising=False)
+    monkeypatch.delenv("API_SERVER_INFERENCE_MODEL", raising=False)
+    adapter._create_agent(session_id="api-chat")
+    assert captured[0]["model"] == "bulk-model"
+    assert captured[0]["provider"] == "local"
+    assert captured[0]["request_overrides"] == {"temperature": 0.1}
+    assert calls == []
+
+
+def test_unknown_explicit_api_provider_is_refused_before_paid_fallback(monkeypatch):
+    adapter, captured, calls = _disposable_adapter(monkeypatch)
+    monkeypatch.setenv("API_SERVER_INFERENCE_PROVIDER", "missing-provider")
+    monkeypatch.setenv("API_SERVER_INFERENCE_MODEL", "interactive-model")
+    monkeypatch.setattr("hermes_cli.runtime_provider.is_routable_provider",
+                        create_autospec(is_routable_provider, return_value=False))
+    with pytest.raises(_ProviderAuthResolutionError, match="not a configured route"):
+        adapter._create_agent(session_id="api-chat")
+    assert not captured and not calls
+
+
+def test_unexpected_openrouter_fallback_is_refused_for_named_provider(monkeypatch):
+    adapter, captured, _calls = _disposable_adapter(monkeypatch)
+    monkeypatch.setenv("API_SERVER_INFERENCE_PROVIDER", "deepseek")
+    monkeypatch.setenv("API_SERVER_INFERENCE_MODEL", "deepseek-flash")
+    def fallback(*, requested=None, target_model=None, **_kwargs):
+        return {"provider": "openrouter", "requested_provider": requested,
+                "base_url": "https://openrouter.test/v1", "api_key": "fallback-key"}
+    monkeypatch.setattr("hermes_cli.runtime_provider.resolve_runtime_provider",
+                        create_autospec(resolve_runtime_provider, side_effect=fallback))
+    with pytest.raises(_ProviderAuthResolutionError, match="fell back to OpenRouter"):
+        adapter._create_agent(session_id="api-chat")
+    assert not captured
