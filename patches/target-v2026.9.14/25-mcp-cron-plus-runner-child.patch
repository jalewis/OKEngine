+# OKEngine #1010: cron-plus runners are direct gateway children (its ticker thread Popens
+# ``<plugins>/cron-plus/runner.py``), so a runner spawned during an MCP stdio connect lands in
+# the transport's child-PID delta and is killed with that server. Discovery is the gateway's MCP
+# entry point, so the marker is added here (keeps the carried patch inside the file budget).
+_lifecycle._NON_MCP_CHILD_CMDLINE_MARKERS = (
+    *_lifecycle._NON_MCP_CHILD_CMDLINE_MARKERS, "cron-plus/runner.py")
+
 
