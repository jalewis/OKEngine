@@ -0,0 +1,111 @@
+"""MCP resource guidance must not turn valid file:// resources into local paths."""
+
+import asyncio
+import json
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from tools.mcp_tool_handlers import _make_read_resource_handler
+from tools.mcp_tool_schema import _build_utility_schemas
+
+
+class _ResourceNotFound(Exception):
+    def __init__(self):
+        super().__init__("Resource not found")
+        self.error = SimpleNamespace(code=-32002)
+
+
+class _Session:
+    def __init__(self, result):
+        self.result = result
+        self.uris = []
+
+    async def read_resource(self, uri):
+        self.uris.append(uri)
+        if isinstance(self.result, BaseException):
+            raise self.result
+        return self.result
+
+
+class _Server:
+    def __init__(self, session):
+        self.session = session
+        self._rpc_lock = asyncio.Lock()
+
+
+def _invoke(uri, result):
+    session = _Session(result)
+    server = _Server(session)
+
+    def _run_on_loop(factory, timeout):
+        return asyncio.run(factory())
+
+    with (
+        patch("tools.mcp_tool_discovery._get_connected_server_for_call", autospec=True, return_value=server),
+        patch("tools.mcp_tool_loop._run_on_mcp_loop", autospec=True, side_effect=_run_on_loop),
+    ):
+        response = json.loads(_make_read_resource_handler("fixture", 5)({"uri": uri}))
+    assert session.uris == [uri], "the handler must pass the MCP URI through unchanged"
+    return response
+
+
+def test_schema_distinguishes_mcp_resource_from_local_file_and_preserves_templates():
+    entry = next(s for s in _build_utility_schemas("fixture") if s["handler_key"] == "read_resource")
+    schema = entry["schema"]
+    assert schema["parameters"]["required"] == ["uri"]
+    assert "list_resources" in schema["description"]
+    assert "template" in schema["description"]
+    assert "read_file" in schema["description"]
+    assert "file://" in schema["parameters"]["properties"]["uri"]["description"]
+
+
+@pytest.mark.parametrize("uri", [
+    "file:///server/advertised/report.txt",
+    "file:///server/templates/generated.txt",
+])
+def test_advertised_or_template_file_uri_is_read_successfully_without_correction(uri):
+    result = _invoke(uri, SimpleNamespace(contents=[SimpleNamespace(text="server content", blob=None)]))
+    assert result == {"result": "server content"}
+
+
+def test_missing_file_uri_receives_conditional_local_path_correction():
+    result = _invoke("file:///invented/local/path.txt", _ResourceNotFound())
+    assert "error" in result
+    assert "If this file:// URI was invented" in result["error"]
+    assert "read_file" in result["error"]
+    assert "get_page" in result["error"]
+
+
+@pytest.mark.parametrize("exc", [ConnectionError("transport down"), TimeoutError("RPC timed out")])
+def test_transport_failure_does_not_claim_file_uri_is_invalid(exc):
+    result = _invoke("file:///server/advertised/report.txt", exc)
+    assert "error" in result
+    assert "invented" not in result["error"]
+
+
+def test_non_file_resource_failure_does_not_suggest_local_file_tool():
+    result = _invoke("vault://missing-page", _ResourceNotFound())
+    assert "error" in result
+    assert "read_file" not in result["error"]
+
+
+def test_disconnected_server_fails_before_reading_an_advertised_uri():
+    with patch("tools.mcp_tool_discovery._get_connected_server_for_call",
+               autospec=True, return_value=None):
+        response = json.loads(_make_read_resource_handler("fixture", 5)(
+            {"uri": "file:///server/advertised/report.txt"}))
+    assert "not connected" in response["error"]
+    assert "invented" not in response["error"]
+
+
+def test_missing_uri_fails_before_mcp_transport_and_without_local_path_advice():
+    session = _Session(SimpleNamespace(contents=[]))
+    server = _Server(session)
+    with patch("tools.mcp_tool_discovery._get_connected_server_for_call",
+               autospec=True, return_value=server):
+        response = json.loads(_make_read_resource_handler("fixture", 5)({}))
+    assert "Missing required parameter 'uri'" in response["error"]
+    assert "invented" not in response["error"]
+    assert session.uris == [], "missing input must not make an MCP transport call"
