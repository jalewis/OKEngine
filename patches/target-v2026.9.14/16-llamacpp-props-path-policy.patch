diff --git a/tests/agent/test_okengine_llamacpp_props_paths.py b/tests/agent/test_okengine_llamacpp_props_paths.py
new file mode 100644
index 000000000..4229060f2
--- /dev/null
+++ b/tests/agent/test_okengine_llamacpp_props_paths.py
@@ -0,0 +1,130 @@
+"""Bounded llama.cpp path learning without losing router children."""
+
+import json
+import time
+from unittest.mock import patch
+
+import httpx
+import pytest
+import requests
+
+from agent import model_metadata as metadata
+
+
+def _response(status, payload=None):
+    response = requests.Response()
+    response.status_code = status
+    response._content = json.dumps(payload or {}).encode("utf-8")
+    return response
+
+
+@pytest.fixture(autouse=True)
+def _clear_props_path_cache():
+    metadata._llamacpp_props_path_cache.clear()
+    yield
+    metadata._llamacpp_props_path_cache.clear()
+
+
+@pytest.mark.parametrize("supported_path,first_urls", [
+    ("/v1/props", ["/v1/props"]),
+    ("/props", ["/v1/props", "/props"]),
+])
+def test_current_and_old_props_paths_are_reused_without_repeat_404(supported_path, first_urls):
+    metadata._ensure_requests()
+    urls = []
+
+    def get(url, **_kwargs):
+        urls.append(url)
+        return _response(200 if url.removeprefix("http://127.0.0.1:8841") == supported_path else 404, {
+            "model_alias": "fixture", "default_generation_settings": {"n_ctx": 32768}})
+
+    cache = {"fixture": {"context_length": 0}}
+    with patch("agent.model_metadata.requests.get", autospec=True, side_effect=get):
+        metadata._apply_llamacpp_props(cache, "http://127.0.0.1:8841/v1", {}, True)
+        assert cache["fixture"]["context_length"] == 32768
+        metadata._apply_llamacpp_props(cache, "http://127.0.0.1:8841/v1", {}, True)
+    assert [url.removeprefix("http://127.0.0.1:8841") for url in urls] == (
+        first_urls + [supported_path]), "the learned success path must be first on refresh"
+
+
+def test_neither_props_path_is_negative_cached_then_recovers_after_ttl():
+    metadata._ensure_requests()
+    available = False
+    urls = []
+
+    def get(url, **_kwargs):
+        urls.append(url)
+        if url.endswith("/models"):
+            return _response(404)
+        return _response(200 if available and url == "http://127.0.0.1:8842/props" else 404, {
+            "model_alias": "fixture", "default_generation_settings": {"n_ctx": 16384}})
+
+    cache = {"fixture": {"context_length": 0}}
+    base = "http://127.0.0.1:8842"
+    with patch("agent.model_metadata.requests.get", autospec=True, side_effect=get):
+        metadata._apply_llamacpp_props(cache, base + "/v1", {}, True)
+        assert len(urls) == 3, "two props paths plus native router check"
+        metadata._apply_llamacpp_props(cache, base + "/v1", {}, True)
+        assert len(urls) == 4, "fresh negative should skip both guaranteed misses"
+        metadata._llamacpp_props_path_cache[(base, None)] = (
+            None, time.monotonic() - metadata._LLAMACPP_PROPS_FAILURE_TTL_SECONDS - 1)
+        available = True
+        metadata._apply_llamacpp_props(cache, base + "/v1", {}, True)
+    assert cache["fixture"]["context_length"] == 16384
+    assert urls[-2:] == [base + "/v1/props", base + "/props"]
+
+
+def test_router_bare_negative_does_not_hide_distinct_loaded_children():
+    metadata._ensure_requests()
+    urls = []
+
+    def get(url, *, params=None, **_kwargs):
+        urls.append((url, params))
+        if url.endswith("/models"):
+            return _response(200, {"data": [
+                {"id": "missing", "status": {"value": "loaded"}},
+                {"id": "ready", "status": {"value": "ready"}},
+                {"id": "unloaded", "status": {"value": "unloaded"}}]})
+        if params and params.get("model") == "ready" and url == "http://127.0.0.1:8843/props":
+            return _response(200, {"default_generation_settings": {"n_ctx": 65536}})
+        return _response(404)
+
+    base = "http://127.0.0.1:8843"
+    cache = {name: {"context_length": 0} for name in ("missing", "ready", "unloaded")}
+    with patch("agent.model_metadata.requests.get", autospec=True, side_effect=get):
+        metadata._apply_llamacpp_props(cache, base + "/v1", {}, True)
+        assert cache["ready"]["context_length"] == 65536
+        assert cache["missing"]["context_length"] == 0
+        assert cache["unloaded"]["context_length"] == 0
+        assert (base + "/props", {"model": "ready"}) in urls
+        assert not any(params == {"model": "unloaded"} for _url, params in urls)
+        before = len(urls)
+        metadata._apply_llamacpp_props(cache, base + "/v1", {}, True)
+    assert len(urls) - before == 2, (
+        "fresh bare/child negatives skip props; only /models and the ready child recheck")
+
+
+def test_llamacpp_context_skips_unsupported_detail_but_keeps_list_fallback():
+    base = "http://127.0.0.1:8844"
+    seen = []
+
+    def handle(request):
+        seen.append(request.url.path)
+        if request.url.path == "/v1/models":
+            return httpx.Response(200, json={"data": [{"id": "fixture", "meta": {"n_ctx": 49152}}]})
+        return httpx.Response(404, json={"error": "not found"})
+
+    transport = httpx.MockTransport(handle)
+    real_client = httpx.Client
+
+    def client_factory(*_args, **kwargs):
+        return real_client(transport=transport, timeout=kwargs.get("timeout", 3.0),
+                           headers=kwargs.get("headers"))
+
+    with (patch("agent.model_metadata.detect_local_server_type", autospec=True,
+                return_value="llamacpp"),
+          patch("httpx.Client", autospec=True, side_effect=client_factory)):
+        result = metadata._query_local_context_length_uncached("fixture", base + "/v1")
+    assert result == 49152, "the supported /v1/models list may supply runtime context"
+    assert "/v1/models/fixture" not in seen, (
+        "known llama.cpp does not implement the per-model detail endpoint")
