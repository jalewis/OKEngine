diff --git a/tests/tools/test_okengine_deepseek_eager_local.py b/tests/tools/test_okengine_deepseek_eager_local.py
new file mode 100644
index 0000000..0f25263
--- /dev/null
+++ b/tests/tools/test_okengine_deepseek_eager_local.py
@@ -0,0 +1,92 @@
+"""DeepSeek Flash cron sessions keep governed local writers off the generic bridge."""
+
+import json
+from pathlib import Path
+
+from cron.scheduler import _CronAgentSetup, _requires_eager_local_tools
+from model_tools import (
+    get_tool_definitions, handle_function_call, reset_eager_local_tools,
+    set_eager_local_tools,
+)
+from tools.mcp_tool_schema import mcp_prefixed_tool_name
+from tools.registry import registry
+from tools.tool_search import resolve_underlying_call
+
+
+FIXTURE = Path(__file__).parents[1] / "fixtures" / "deepseek_flash_multi_local_tool_call.json"
+SERVER = "okengine-write-market-intelligence-classification-worker"
+TOOLSET = f"mcp-{SERVER}"
+
+
+def _name(tool_def):
+    return tool_def["function"]["name"]
+
+
+def test_captured_deepseek_multi_local_bridge_response_remains_fail_closed():
+    response = json.loads(FIXTURE.read_text(encoding="utf-8"))
+    raw = response["choices"][0]["message"]["tool_calls"][0]["function"]["arguments"]
+    name, arguments, error = resolve_underlying_call(json.loads(raw))
+    assert name is None
+    assert arguments == {}
+    assert "one entry per tool_call" in error
+
+
+def test_deepseek_flash_provider_qualification_is_narrow():
+    assert not _requires_eager_local_tools(type("MinimalSetup", (), {"model": "deepseek-flash"})())
+    assert _requires_eager_local_tools(_CronAgentSetup(
+        model="deepseek-flash", runtime={"provider": "deepseek"}))
+    assert not _requires_eager_local_tools(_CronAgentSetup(
+        model="deepseek-flash", runtime={"provider": "openrouter"}))
+    assert not _requires_eager_local_tools(_CronAgentSetup(
+        model="another-model", runtime={"provider": "deepseek"}))
+
+
+def test_single_hashed_writer_is_direct_and_reaches_registered_handler(monkeypatch, capsys):
+    from tools.tool_search import ToolSearchConfig
+
+    tool_search_config = ToolSearchConfig(
+        enabled="on", threshold_pct=10, search_default_limit=5, max_search_limit=20)
+    monkeypatch.setattr("tools.tool_search.load_config", lambda: tool_search_config)
+    monkeypatch.setattr("tools.tool_search.load_config_readonly", lambda: tool_search_config)
+    physical_name = mcp_prefixed_tool_name(SERVER, "update_entity_with_governed_evidence")
+    assert len(physical_name) <= 64
+    calls = []
+
+    def writer(arguments, **_kwargs):
+        calls.append(arguments)
+        return json.dumps({"response": "updated entities/a v2"})
+
+    registry.register(
+        name=physical_name,
+        toolset=TOOLSET,
+        schema={
+            "name": physical_name,
+            "description": "Update one governed entity.",
+            "parameters": {
+                "type": "object",
+                "properties": {"path": {"type": "string"}},
+                "required": ["path"],
+            },
+        },
+        handler=writer,
+    )
+    try:
+        ordinary = get_tool_definitions(enabled_toolsets=[TOOLSET], quiet_mode=False)
+        assert "Tool Search" in capsys.readouterr().out
+        assert physical_name not in {_name(item) for item in ordinary}
+        assert "tool_call" in {_name(item) for item in ordinary}
+
+        token = set_eager_local_tools(True)
+        try:
+            eager = get_tool_definitions(enabled_toolsets=[TOOLSET], quiet_mode=True)
+            names = {_name(item) for item in eager}
+            assert physical_name in names
+            assert "tool_call" not in names
+            result = json.loads(handle_function_call(
+                physical_name, {"path": "entities/a"}, enabled_toolsets=[TOOLSET]))
+        finally:
+            reset_eager_local_tools(token)
+        assert result == {"response": "updated entities/a v2"}
+        assert calls == [{"path": "entities/a"}]
+    finally:
+        registry.deregister(physical_name)
