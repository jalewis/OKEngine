+def _requires_eager_local_tools(setup: _CronAgentSetup) -> bool:
+    """DeepSeek V4.1 Flash cron runs avoid its unstable generic local bridge.
+
+    This is deliberately provider-qualified and model-qualified: other models
+    keep progressive disclosure, and connector calls remain deferred.
+    """
+    candidate_runtime = getattr(setup, "runtime", None)
+    runtime = candidate_runtime if isinstance(candidate_runtime, dict) else {}
+    provider = str(runtime.get("provider") or "").strip().lower()
+    model = str(setup.model or "").strip().lower()
+    return provider == "deepseek" and model in {
+        "deepseek-flash", "deepseek-v4.1-flash", "deepseek/deepseek-v4.1-flash",
+    }
+
