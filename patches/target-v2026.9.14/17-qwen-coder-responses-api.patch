new file mode 100644
--- /dev/null
+++ b/tests/agent/test_okengine_qwen_responses_transport.py
@@ -0,0 +1,57 @@
+"""OKEngine's custom Qwen Coder wire route remains Responses until canary."""
+
+import sys
+import types
+from types import SimpleNamespace
+
+import pytest
+
+sys.modules.setdefault("fire", types.SimpleNamespace(Fire=lambda *a, **k: None))
+sys.modules.setdefault("firecrawl", types.SimpleNamespace(Firecrawl=object))
+sys.modules.setdefault("fal_client", types.SimpleNamespace())
+
+import run_agent
+from agent.agent_init import _resolve_api_mode
+from agent.codex_responses_adapter import _preflight_codex_input_items
+
+
+def _routing_probe(model, provider, requested_mode):
+    """Exercise the real model rule and ordered resolver without network bootstrap."""
+    base_url = "http://127.0.0.1:18080/v1"
+    agent = SimpleNamespace(
+        model=model,
+        provider=provider,
+        _base_url_hostname="127.0.0.1",
+        _base_url_lower=base_url,
+        _provider_model_requires_responses_api=run_agent.AIAgent._provider_model_requires_responses_api,
+    )
+    _resolve_api_mode(agent, requested_mode, provider, base_url)
+    return agent
+
+
+@pytest.mark.parametrize("model", ["qwen3-coder", "qwen-coder-32b", "vendor/qwen3-coder-next"])
+def test_custom_qwen_coder_forces_responses_despite_explicit_chat(model):
+    agent = _routing_probe(model, "custom", "chat_completions")
+    assert agent.api_mode == "codex_responses", (
+        "custom Qwen Coder must preserve /v1/responses until canary, even with explicit Chat"
+    )
+
+
+@pytest.mark.parametrize("model,provider", [
+    ("qwen3-coder", "nous"),
+    ("other-custom-model", "custom"),
+    ("gpt-5.4", "custom"),
+])
+def test_non_custom_qwen_routes_respect_explicit_chat(model, provider):
+    agent = _routing_probe(model, provider, "chat_completions")
+    assert agent.api_mode == "chat_completions", (
+        "Qwen override must not change non-custom or non-Qwen endpoint profiles"
+    )
+
+
+def test_custom_qwen_user_history_preflights_to_typed_message():
+    actual = _preflight_codex_input_items([{"role": "user", "content": "question"}])
+    assert actual == [{
+        "type": "message", "role": "user",
+        "content": [{"type": "input_text", "text": "question"}],
+    }], "strict /v1/responses gateways reject untyped role-bearing history"
