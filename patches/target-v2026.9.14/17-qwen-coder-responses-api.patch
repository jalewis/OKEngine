@@ -0,0 +1,35 @@
+"""Run the native TTFB contracts under OKEngine's strict Responses preflight."""
+from __future__ import annotations
+
+import runpy
+from pathlib import Path
+
+import pytest
+
+
+_NATIVE = runpy.run_path(Path(__file__).with_name("test_codex_ttfb_watchdog.py"))
+_ADAPTED = "test_event_stale_phase_is_scoped_to_physical_stream_attempt"
+
+# Preserve the complete native contract file. Only the one lower-level test
+# that deliberately builds a partial wire request needs an OKEngine adapter;
+# production requests already carry instructions before this boundary.
+for _name, _value in _NATIVE.items():
+    if _name.startswith("test_") and _name != _ADAPTED:
+        globals()[_name] = _value
+
+
+@pytest.mark.parametrize("mode", ["initial_gap", "stall", "retry_gap", "retry_no_event"])
+def test_event_stale_phase_is_scoped_to_physical_stream_attempt(
+    tmp_path, monkeypatch, mode,
+):
+    from agent import chat_completion_helpers as helpers
+
+    native_call = helpers.interruptible_api_call
+
+    def strict_call(agent, api_kwargs):
+        request = dict(api_kwargs)
+        request.setdefault("instructions", "Exercise the stream watchdog contract.")
+        return native_call(agent, request)
+
+    monkeypatch.setattr(helpers, "interruptible_api_call", strict_call)
+    return _NATIVE[_ADAPTED](tmp_path, monkeypatch, mode)
