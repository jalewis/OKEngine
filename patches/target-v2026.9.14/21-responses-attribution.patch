+_ATTRIBUTION_TOKEN = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._:/-]*\Z")
+
+
+def _bounded_attribution_token(raw: object, *, limit: int = 96) -> str:
+    """Header-safe stable identity; hash unusual/long values, never emit controls."""
+    if not isinstance(raw, str) or not raw.strip():
+        return ""
+    value = raw.strip()
+    digest = hashlib.sha256(value.encode("utf-8")).hexdigest()
+    if not _ATTRIBUTION_TOKEN.fullmatch(value):
+        return "sha256:" + digest[:min(48, limit - 7)]
+    if len(value) <= limit:
+        return value
+    suffix = "-" + digest[:16]
+    return value[:limit - len(suffix)] + suffix
+
+
+def _with_okengine_responses_attribution(agent: Any, request: dict) -> dict:
+    """Attach scoped identities to one physical Responses attempt only."""
+    raw_headers = request.get("extra_headers")
+    if raw_headers is not None and not isinstance(raw_headers, Mapping):
+        raise ValueError("Responses extra_headers must be a mapping")
+    headers = dict(raw_headers or {})
+
+    def has(name: str) -> bool:
+        return any(isinstance(key, str) and key.casefold() == name.casefold()
+                   for key in headers)
+
+    pack = os.environ.get("OKENGINE_PACK", "").strip()
+    component = os.environ.get("OKENGINE_LLM_COMPONENT", "").strip()
+    pack = pack if _ATTRIBUTION_TOKEN.fullmatch(pack) else "unknown"
+    component = component if _ATTRIBUTION_TOKEN.fullmatch(component) else ""
+    client_id = "okengine/" + pack + ("/" + component if component else "")
+    if not has("X-Client-Id"):
+        headers["X-Client-Id"] = _bounded_attribution_token(client_id)
+
+    conversation = _bounded_attribution_token(getattr(agent, "session_id", None))
+    if conversation:
+        if not has("X-Conversation-Id"):
+            headers["X-Conversation-Id"] = conversation
+    elif not has("X-Conversation-Id") and not has("X-Oneshot"):
+        headers["X-Oneshot"] = "1"
+    return {**request, "extra_headers": headers}
+
 
