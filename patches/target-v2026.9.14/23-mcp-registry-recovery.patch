index 000000000..bc3fece79
--- /dev/null
+++ b/tests/agent/test_okengine_mcp_registry_loss_turn.py
@@ -0,0 +1,61 @@
+"""Only an advertised physical registry miss interrupts the owning agent."""
+
+from unittest.mock import create_autospec, patch
+
+from agent.conversation_loop import run_conversation
+from cron.scheduler import _enforce_mcp_registry_integrity
+from run_agent import AIAgent
+from tools.registry import registry
+
+
+NAME = "mcp__okengine_read__get_page"
+
+
+def _agent(*, advertised=True):
+    agent = create_autospec(AIAgent, instance=True)
+    agent.valid_tool_names = {NAME} if advertised else {"terminal"}
+    agent._okengine_mcp_registry_losses = []
+    return agent
+
+
+def _turn_with_unrecovered_dispatch(agent):
+    registry.deregister(NAME)
+
+    def execute(_agent, _message, **_kwargs):
+        registry.dispatch(NAME, {})
+        return {"final_response": "disposable result"}
+
+    with patch("tools.mcp_tool_discovery.recover_missing_mcp_tool", autospec=True,
+               return_value=False), patch(
+                   "agent.conversation_loop._run_conversation_turn", autospec=True,
+                   side_effect=execute), patch(
+                       "agent.turn_context.export_current_turn_boundary", autospec=True,
+                       side_effect=lambda _agent, result, _message: result):
+        return run_conversation(agent, "disposable prompt")
+
+
+def test_advertised_missing_handler_interrupts_once_and_blocks_cron_success():
+    agent = _agent()
+    assert _turn_with_unrecovered_dispatch(agent)["final_response"] == "disposable result"
+    assert agent._okengine_mcp_registry_losses == [NAME]
+    agent.interrupt.assert_called_once_with(f"MCP registry integrity lost: {NAME}")
+    _turn_with_unrecovered_dispatch(agent)
+    assert agent.interrupt.call_count == 1, "a repeated miss must not cause an interrupt storm"
+    job = {"_okengine_mcp_registry_losses": ["stale"]}
+    try:
+        _enforce_mcp_registry_integrity(agent, job)
+    except RuntimeError as exc:
+        assert NAME in str(exc)
+    else:
+        raise AssertionError("an advertised registry loss became a clean cron outcome")
+    assert job["_okengine_mcp_registry_losses"] == [NAME]
+
+
+def test_unadvertised_mcp_name_is_not_a_registry_integrity_alarm():
+    agent = _agent(advertised=False)
+    _turn_with_unrecovered_dispatch(agent)
+    assert agent._okengine_mcp_registry_losses == []
+    agent.interrupt.assert_not_called()
+    job = {"_okengine_mcp_registry_losses": ["stale"]}
+    _enforce_mcp_registry_integrity(agent, job)
+    assert job["_okengine_mcp_registry_losses"] == []
