+"""A dispatched terminal OKEngine MCP transport failure fails the cron fire."""
+
+import json
+import time
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import cron.jobs as cron_jobs
+from cron.scheduler import run_job
+from tools.mcp_tool_handlers import _check_circuit_breaker, _make_tool_handler, _strike
+from tools.mcp_transport_failure_telemetry import (
+    capture_mcp_transport_failures, record_mcp_transport_failure)
+from tools.registry import ToolRegistry
+
+
+def _job():
+    return {
+        "id": "transport-loss", "name": "transport-loss", "prompt": "disposable prompt",
+        "enabled": True, "state": "scheduled", "enabled_toolsets": ["terminal"],
+        "schedule": {"kind": "interval", "minutes": 5, "display": "every 5m"},
+        "deliver": "local", "model": None, "provider": None, "base_url": None,
+    }
+
+
+def test_disconnected_dispatched_read_handler_marks_cron_failed_and_audited(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text(
+        "model:\n  default: local-fixture\ncron:\n  preflight: false\n",
+        encoding="utf-8")
+    runtime = {"api_key": "disposable-key", "base_url": "http://127.0.0.1:8845/v1",
+               "provider": "custom", "api_mode": "chat_completions"}
+    tool_result = []
+    name = "mcp__okengine_read__get_page"
+    tool_registry = ToolRegistry()
+    tool_registry.register(
+        name=name, toolset="mcp-okengine-read",
+        schema={"name": name, "parameters": {"type": "object", "properties": {}}},
+        handler=_make_tool_handler("okengine-read", "get_page", 0.01))
+
+    def run_agent(_prompt, **_kwargs):
+        tool_result.append(tool_registry.dispatch(name, {}))
+        return {"final_response": "looks successful"}
+
+    with patch("run_agent.AIAgent", autospec=True) as agent_cls, patch(
+        "cron.scheduler._hermes_home", tmp_path), patch(
+            "cron.scheduler_delivery._resolve_origin", autospec=True,
+            return_value=None), patch(
+                "hermes_cli.env_loader.load_hermes_dotenv", autospec=True), patch(
+                    "hermes_cli.env_loader.reset_secret_source_cache", autospec=True), patch(
+                        "hermes_state_registry.acquire", autospec=True,
+                        return_value=None), patch(
+                            "tools.mcp_tool_discovery.discover_mcp_tools",
+                            autospec=True, return_value=[]), patch(
+                                "tools.mcp_tool_discovery._get_connected_server_for_call",
+                                autospec=True, return_value=None), patch(
+                                    "hermes_cli.runtime_provider.resolve_runtime_provider",
+                                    autospec=True, return_value=runtime):
+        agent_cls.return_value.run_conversation.side_effect = run_agent
+        job = _job()
+        with cron_jobs.use_cron_store(tmp_path):
+            cron_jobs.save_jobs([job])
+            success, output, final, error = run_job(job)
+    assert tool_result and "not connected" in json.loads(tool_result[0])["error"]
+    assert success is False and final == ""
+    assert "FAILED" in output
+    assert error and "OKEngine MCP transport unavailable: okengine-read" in error
+    assert job["_okengine_mcp_transport_failures"] == ["okengine-read"]
+    rows = [json.loads(line) for line in (
+        tmp_path / "cron" / "usage_audit.jsonl").read_text(encoding="utf-8").splitlines()]
+    assert len(rows) == 1 and "okengine-read" in rows[0]["error"]
+
+
+def test_only_terminal_okengine_transport_is_recorded_and_context_resets():
+    seen = []
+    with capture_mcp_transport_failures(seen.append):
+        record_mcp_transport_failure("other-server")
+        record_mcp_transport_failure("okengine-write")
+    record_mcp_transport_failure("okengine-read")
+    assert seen == ["okengine-write"]
+
+
+def test_host_generated_retry_failure_records_transport_not_application_error():
+    seen = []
+    with capture_mcp_transport_failures(seen.append):
+        result = _strike("okengine-read", "disposable reconnect failed")
+    assert "disposable reconnect failed" in json.loads(result)["error"]
+    assert seen == ["okengine-read"]
+
+
+def test_reauthentication_requirement_is_not_mislabeled_transport():
+    seen = []
+    with capture_mcp_transport_failures(seen.append):
+        result = _strike("okengine-read", "disposable login needed", needs_reauth=True)
+    assert json.loads(result)["needs_reauth"] is True
+    assert seen == []
+
+
+def test_application_only_open_breaker_does_not_record_unreachable(monkeypatch):
+    from tools.mcp_tool_common import _core
+    from tools.mcp_tool_scope import _resolve_server_key
+
+    key = _resolve_server_key("okengine-read")
+    monkeypatch.setitem(_core._server_error_counts, key, _core._CIRCUIT_BREAKER_THRESHOLD)
+    monkeypatch.setitem(_core._server_breaker_opened_at, key, time.monotonic())
+    monkeypatch.setitem(_core._server_errors_all_application, key, True)
+    seen = []
+    with capture_mcp_transport_failures(seen.append):
+        result = _check_circuit_breaker("okengine-read")
+    assert result and "rejected" in json.loads(result)["error"]
+    assert seen == [], "a reachable server's application rejection is not a transport outage"
+
+
+def test_transport_open_breaker_records_unreachable(monkeypatch):
+    from tools.mcp_tool_common import _core
+    from tools.mcp_tool_scope import _resolve_server_key
+
+    key = _resolve_server_key("okengine-read")
+    monkeypatch.setitem(_core._server_error_counts, key, _core._CIRCUIT_BREAKER_THRESHOLD)
+    monkeypatch.setitem(_core._server_breaker_opened_at, key, time.monotonic())
+    monkeypatch.setitem(_core._server_errors_all_application, key, False)
+    seen = []
+    with capture_mcp_transport_failures(seen.append):
+        result = _check_circuit_breaker("okengine-read")
+    assert result and "unreachable" in json.loads(result)["error"]
+    assert seen == ["okengine-read"]
+
+
+def test_unrecovered_rpc_timeout_records_terminal_transport(monkeypatch):
+    from tools.mcp_tool_common import _core
+    from tools.mcp_tool_scope import _resolve_server_key
+
+    key = _resolve_server_key("okengine-read")
+    monkeypatch.setitem(_core._server_error_counts, key, 0)
+    server = SimpleNamespace(session=object())  # RPC is replaced at the external loop boundary
+    seen = []
+    with patch("tools.mcp_tool_discovery._get_connected_server_for_call",
+               autospec=True, return_value=server), patch(
+                   "tools.mcp_tool_loop._run_on_mcp_loop", autospec=True,
+                   side_effect=TimeoutError("disposable RPC timeout")):
+        with capture_mcp_transport_failures(seen.append):
+            result = _make_tool_handler("okengine-read", "get_page", 0.01)({})
+    assert "MCP call failed" in json.loads(result)["error"]
+    assert seen == ["okengine-read"]
