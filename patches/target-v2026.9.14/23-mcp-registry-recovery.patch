+def recover_missing_mcp_tool(tool_name: str, *, timeout: float = 5.0) -> bool:
+    """Give a configured, profile-visible MCP tool one bounded republish opportunity.
+
+    A parked transport removes handlers from the registry. Its reconnect may
+    complete after an already-advertised call arrives, or may miss publication.
+    Never borrow another profile's differently authenticated connection.
+    """
+    from tools.registry import registry
+
+    if not isinstance(tool_name, str) or not tool_name.startswith(MCP_TOOL_NAME_PREFIX):
+        return False
+    if registry.get_entry(tool_name) is not None:
+        return True
+    try:
+        seconds = float(timeout)
+    except (TypeError, ValueError):
+        return False
+    if not math.isfinite(seconds):
+        return False
+    deadline = time.monotonic() + min(5.0, max(0.0, seconds))
+    configured = _config._load_mcp_config() or {}
+    matching = [(name, cfg) for name, cfg in configured.items()
+                if isinstance(cfg, dict) and _enabled(cfg) and
+                tool_name.startswith(f"mcp__{sanitize_mcp_name_component(name)}__")]
+    if len(matching) != 1:
+        return False  # disabled/unconfigured or lossy-name collision
+    name, cfg = matching[0]
+    attempted_sessions: set[int] = set()
+
+    def republish_if_ready() -> bool:
+        with _core._lock:
+            key = _resolve_server_key(name)
+            server = _core._servers.get(key)
+            scope = _core._mcp_registry_scope()
+            visible = server is not None and _core._server_visible_in_scope(key, scope)
+        session = getattr(server, "session", None)
+        if not visible or session is None:
+            return False
+        ready = getattr(server, "_ready", None)
+        if hasattr(ready, "is_set") and not ready.is_set():
+            return False
+        cross_profile = _key_scope(key) != scope
+        if not _registration._same_server_route(server, cfg, cross_profile=cross_profile):
+            return False
+        session_key = id(session)
+        if session_key in attempted_sessions:
+            return False
+        attempted_sessions.add(session_key)
+        if cross_profile:
+            _registration.register_connected_into_current_scope({name: cfg})
+        else:
+            _registration._register_server_tools(name, server, cfg)
+        return registry.get_entry(tool_name) is not None
+
+    if republish_if_ready():
+        logger.warning("MCP tool '%s' republished on demand", tool_name)
+        return True
+    with _core._lock:
+        server = _core._servers.get(_resolve_server_key(name))
+    if server is None:
+        return False
+    if getattr(server, "session", None) is None:
+        _loop._signal_reconnect(server)
+    while True:
+        if registry.get_entry(tool_name) is not None or republish_if_ready():
+            logger.warning("MCP tool '%s' recovered after reconnect", tool_name)
+            return True
+        if time.monotonic() >= deadline:
+            return False
+        time.sleep(0.05)
+
+
