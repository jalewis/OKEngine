+"""Authentic unrecovered MCP registry misses, scoped to the current agent turn."""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+import logging
+from typing import Callable, Iterator
+
+logger = logging.getLogger(__name__)
+_miss_sink: ContextVar[Callable[[str], None] | None] = ContextVar(
+    "mcp_registry_missing_sink", default=None)
+
+
+@contextmanager
+def capture_mcp_registry_misses(sink: Callable[[str], None]) -> Iterator[None]:
+    token = _miss_sink.set(sink)
+    try:
+        yield
+    finally:
+        _miss_sink.reset(token)
+
+
+def record_unrecovered_mcp_registry_miss(name: str) -> None:
+    sink = _miss_sink.get()
+    if sink is not None:
+        try:
+            sink(name)
+        except Exception:
+            logger.exception("MCP registry miss sink failed for %s", name)
