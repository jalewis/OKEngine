+from tools import registry as registry_module
+
+
+@pytest.fixture(autouse=True)
+def clean_check_state():
+    registry_module.invalidate_check_fn_cache()
+    yield
+    registry_module.invalidate_check_fn_cache()
+
+
+def test_file_requirement_uses_the_owning_terminal_module(monkeypatch):
+    import tools
+    from tools import terminal_tool
+
+    monkeypatch.delattr(tools, "check_file_requirements", raising=False)
+    monkeypatch.setattr(terminal_tool, "check_terminal_requirements", lambda: True)
+    assert file_tools._check_file_reqs() is True
+
+
+def test_missing_current_terminal_contract_is_an_import_failure(monkeypatch):
+    from tools import terminal_tool
+
+    monkeypatch.delattr(terminal_tool, "check_terminal_requirements")
+    with pytest.raises(ImportError):
+        file_tools._check_file_reqs()
+
+
+def test_optional_false_is_normal_absence_without_degraded_signal():
+    def optional_unavailable():
+        return False
+
+    assert registry_module._run_check_fn_uncached(optional_unavailable) is False
+    assert registry_module.get_check_fn_diagnostics() == []
+
+
+def test_unexpected_check_error_emits_named_degraded_diagnostic(caplog):
+    def broken_check():
+        raise ImportError("required adapter symbol drifted")
+
+    assert registry_module._run_check_fn_uncached(broken_check) is False
+    assert registry_module.get_check_fn_diagnostics() == [{
+        "signal": "hermes.tool_check.degraded",
+        "check": "test_unexpected_check_error_emits_named_degraded_diagnostic.<locals>.broken_check",
+        "error_type": "ImportError",
+    }]
+    assert "diagnostic=hermes.tool_check.degraded" in caplog.text
+
+
+def test_success_clears_a_previous_degraded_diagnostic():
+    state = {"broken": True}
+
+    def recovering_check():
+        if state["broken"]:
+            raise RuntimeError("temporary internal failure")
+        return True
+
+    assert registry_module._run_check_fn_uncached(recovering_check) is False
+    state["broken"] = False
+    assert registry_module._run_check_fn_uncached(recovering_check) is True
+    assert registry_module.get_check_fn_diagnostics() == []
+
+
+@pytest.mark.parametrize("unresolved_scope", [False, True])
+def test_unscoped_secret_is_expected_fail_closed_not_degraded(
+    unresolved_scope, caplog,
+):
+    from agent.secret_scope import UnscopedSecretError
+
+    caplog.set_level("DEBUG", logger="tools.registry")
+
+    def scoped_check():
+        raise UnscopedSecretError("fixture has no active profile scope")
+
+    assert registry_module._run_check_fn_uncached(
+        scoped_check, unresolved_scope=unresolved_scope,
+    ) is False
+    assert registry_module.get_check_fn_diagnostics() == []
+    expected = (
+        "multiplex fail-closed path"
+        if unresolved_scope
+        else "profile cache scope was resolved"
+    )
+    assert expected in caplog.text
+
+
+def test_cached_check_exception_records_degraded_signal(monkeypatch):
+    def broken_check():
+        raise LookupError("fixture dependency contract drifted")
+
+    monkeypatch.setattr(registry_module, "check_fn_cache_scope", lambda: None)
+    assert registry_module._check_fn_cached(broken_check) is False
+    assert registry_module.get_check_fn_diagnostics() == [{
+        "signal": "hermes.tool_check.degraded",
+        "check": "test_cached_check_exception_records_degraded_signal.<locals>.broken_check",
+        "error_type": "LookupError",
+    }]
+
+
+def test_cached_check_success_clears_existing_degraded_signal(monkeypatch):
+    def recovered_check():
+        return True
+
+    monkeypatch.setattr(registry_module, "check_fn_cache_scope", lambda: None)
