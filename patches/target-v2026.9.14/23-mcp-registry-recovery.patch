@@ -0,0 +1,310 @@
+"""Bounded MCP registry republish and authentic miss telemetry."""
+
+from concurrent.futures import ThreadPoolExecutor
+from contextvars import copy_context
+import json
+from types import SimpleNamespace
+from unittest.mock import create_autospec, patch
+
+from agent.secret_scope import is_multiplex_active
+from hermes_constants import (
+    hermes_home_key, reset_hermes_home_override, set_hermes_home_override)
+from tools import mcp_tool
+from tools.mcp_tool_common import _core
+from tools.mcp_tool_discovery import recover_missing_mcp_tool
+from tools.mcp_registry_loss_telemetry import (
+    capture_mcp_registry_misses, record_unrecovered_mcp_registry_miss)
+from tools.registry import registry
+
+
+NAME = "mcp__okengine_read__get_page"
+CFG = {"okengine-read": {"url": "http://127.0.0.1:9001/mcp"}}
+
+
+def _server(monkeypatch, *, live=True):
+    server = mcp_tool.MCPServerTask("okengine-read")
+    server._config = CFG["okengine-read"]
+    if live:
+        server.session = object()  # disposable transport fixture, never opened
+        server._ready.set()
+    monkeypatch.setitem(mcp_tool._servers, "okengine-read", server)
+    return server
+
+
+def test_live_own_profile_republishes_before_unknown_tool(monkeypatch):
+    _server(monkeypatch)
+    registry.deregister(NAME)
+
+    def register(name, server, config):
+        assert name == "okengine-read" and config == CFG[name]
+        registry.register(
+            name=NAME, toolset="mcp-okengine-read",
+            schema={"name": NAME, "parameters": {"type": "object", "properties": {}}},
+            handler=lambda _args, **_kwargs: "disposable page")
+        return [NAME]
+
+    try:
+        with patch("tools.mcp_tool_config._load_mcp_config", autospec=True,
+                   return_value=CFG), patch(
+                       "tools.mcp_tool_registration._register_server_tools",
+                       autospec=True, side_effect=register) as publish:
+            result = registry.dispatch(NAME, {})
+        assert result == "disposable page"
+        publish.assert_called_once()
+    finally:
+        registry.deregister(NAME)
+
+
+def test_adopted_profile_republishes_only_its_missing_tool(tmp_path, monkeypatch):
+    """A shared live route stays owned by A while B heals its lost overlay."""
+    from tools import mcp_tool_discovery as discovery
+    from tools import mcp_tool_registration as registration
+
+    name = "mcp__profile_republish__get_page"
+    server_name = "profile-republish"
+    cfg = {"url": "https://mcp.example/profile-republish",
+           "headers": {"Authorization": "Bearer disposable-fixture"}}
+    owner_home, adopter_home = tmp_path / "owner", tmp_path / "adopter"
+    owner_home.mkdir()
+    adopter_home.mkdir()
+    owner_scope, adopter_scope = hermes_home_key(owner_home), hermes_home_key(adopter_home)
+    monkeypatch.setattr("agent.secret_scope.is_multiplex_active",
+                        create_autospec(is_multiplex_active, return_value=True))
+    for ledger in ("_servers", "_server_scope_keys", "_server_tool_scopes",
+                   "_server_connecting", "_server_connect_errors",
+                   "_server_connect_retry_after", "_server_connect_failures",
+                   "_server_error_counts", "_server_breaker_opened_at",
+                   "_lazy_server_configs", "_mcp_tool_server_names",
+                   "_orphaned_adopters", "_parallel_safe_servers",
+                   "_server_trust_levels", "_tool_read_only_hints"):
+        monkeypatch.setattr(mcp_tool, ledger, type(getattr(mcp_tool, ledger))())
+    token_owner = set_hermes_home_override(owner_home)
+    try:
+        server = SimpleNamespace(
+            name=server_name, session=object(), _config=cfg,
+            _tools=[SimpleNamespace(name="get_page", description="disposable page",
+                                    inputSchema={"type": "object", "properties": {}},
+                                    annotations=None)],
+            tool_timeout=30, initialize_result=None, _registered_tool_names=[],
+            _sampling=None)
+        discovery._adopt_server(server_name, server)
+        server._registered_tool_names = registration._register_server_tools(
+            server_name, server, cfg)
+        assert registry.get_entry(name, scope=owner_scope) is not None
+        token_adopter = set_hermes_home_override(adopter_home)
+        try:
+            assert registration.register_connected_into_current_scope({server_name: cfg}) == 1
+            assert registry.get_entry(name, scope=adopter_scope) is not None
+            registry.deregister(name, scope=adopter_scope)
+            assert registry.get_entry(name, scope=adopter_scope) is None
+            with patch("tools.mcp_tool_config._load_mcp_config", autospec=True,
+                       return_value={server_name: cfg}):
+                assert recover_missing_mcp_tool(name, timeout=0) is True
+            assert registry.get_entry(name, scope=adopter_scope) is not None
+            assert registry.get_entry(name, scope=owner_scope) is not None
+            assert mcp_tool._servers[(owner_scope, server_name)] is server
+            assert (adopter_scope, server_name) not in mcp_tool._servers
+        finally:
+            registry.deregister(name, scope=adopter_scope)
+            reset_hermes_home_override(token_adopter)
+    finally:
+        registry.deregister(name, scope=owner_scope)
+        reset_hermes_home_override(token_owner)
+
+
+def test_parked_server_gets_reconnect_nudge_but_zero_timeout_stays_bounded(monkeypatch):
+    server = _server(monkeypatch, live=False)
+    registry.deregister(NAME)
+    with patch("tools.mcp_tool_config._load_mcp_config", autospec=True,
+               return_value=CFG), patch("tools.mcp_tool_discovery.discover_mcp_tools",
+                                      autospec=True) as discover:
+        assert recover_missing_mcp_tool(NAME, timeout=0) is False
+    discover.assert_not_called()
+    assert server._reconnect_event.is_set()
+
+
+def test_parked_server_recovers_after_a_new_ready_session(monkeypatch):
+    server = _server(monkeypatch, live=False)
+    registry.deregister(NAME)
+
+    def advance(_seconds):
+        server.session = object()  # disposable reconnect transition
+        server._ready.set()
+
+    def register(_name, _server, _config):
+        registry.register(
+            name=NAME, toolset="mcp-okengine-read",
+            schema={"name": NAME, "parameters": {"type": "object", "properties": {}}},
+            handler=lambda _args, **_kwargs: "disposable recovered page")
+        return [NAME]
+
+    try:
+        with patch("tools.mcp_tool_config._load_mcp_config", autospec=True,
+                   return_value=CFG), patch("tools.mcp_tool_discovery.time.sleep",
+                                          autospec=True, side_effect=advance), patch(
+                                              "tools.mcp_tool_registration._register_server_tools",
+                                              autospec=True, side_effect=register) as publish:
+            assert recover_missing_mcp_tool(NAME, timeout=0.2) is True
+        assert server._reconnect_event.is_set()
+        publish.assert_called_once()
+    finally:
+        registry.deregister(NAME)
+
+
+def test_disabled_unconfigured_and_sanitized_collision_fail_closed():
+    registry.deregister(NAME)
+    for configured in ({}, {"okengine-read": {"enabled": False}},
+                       {"okengine-read": CFG["okengine-read"],
+                        "okengine_read": CFG["okengine-read"]}):
+        with patch("tools.mcp_tool_config._load_mcp_config", autospec=True,
+                   return_value=configured):
+            assert recover_missing_mcp_tool(NAME, timeout=0) is False
+
+
+def test_differently_authenticated_route_never_republishes(monkeypatch):
+    _server(monkeypatch)
+    registry.deregister(NAME)
+    with patch("tools.mcp_tool_config._load_mcp_config", autospec=True,
+               return_value=CFG), patch(
+                   "tools.mcp_tool_registration._same_server_route",
+                   autospec=True, return_value=False) as route, patch(
+                       "tools.mcp_tool_registration._register_server_tools",
+                       autospec=True) as publish:
+        assert recover_missing_mcp_tool(NAME, timeout=0) is False
+    route.assert_called()
+    publish.assert_not_called()
+
+
+def test_only_real_unrecovered_dispatch_miss_records_telemetry_across_thread_context():
+    registry.deregister(NAME)
+    seen = []
+    with patch("tools.mcp_tool_discovery.recover_missing_mcp_tool",
+               autospec=True, return_value=False):
+        with capture_mcp_registry_misses(seen.append):
+            context = copy_context()
+            with ThreadPoolExecutor(max_workers=1) as pool:
+                result = pool.submit(context.run, registry.dispatch, NAME, {}).result()
+        registry.dispatch(NAME, {})  # sink has reset
+    assert json.loads(result)["error"] == f"Unknown tool: {NAME}"
+    assert seen == [NAME]
+
+
+def test_handler_error_text_cannot_forge_a_registry_miss():
+    registry.register(
+        name=NAME, toolset="mcp-okengine-read",
+        schema={"name": NAME, "parameters": {"type": "object", "properties": {}}},
+        handler=lambda _args, **_kwargs: json.dumps({"error": f"Unknown tool: {NAME}"}))
+    seen = []
+    try:
+        with capture_mcp_registry_misses(seen.append):
+            registry.dispatch(NAME, {})
+    finally:
+        registry.deregister(NAME)
+    assert seen == [], "an MCP handler's untrusted result text is not a registry observation"
+
+
+def test_registry_recovery_exception_fails_closed_and_reports_real_miss(caplog):
+    registry.deregister(NAME)
+    seen = []
+    with patch("tools.mcp_tool_discovery.recover_missing_mcp_tool", autospec=True,
+               side_effect=RuntimeError("fixture recovery failed")):
+        with capture_mcp_registry_misses(seen.append):
+            result = registry.dispatch(NAME, {})
+    assert json.loads(result)["error"] == f"Unknown tool: {NAME}"
+    assert seen == [NAME]
+    assert any("MCP registry recovery failed" in row.message for row in caplog.records)
+
+
+def test_registry_handler_exception_is_error_not_registry_loss():
+    registry.deregister(NAME)
+
+    def broken_handler(_args, **_kwargs):
+        raise RuntimeError("fixture handler failed")
+
+    registry.register(
+        name=NAME, toolset="mcp-okengine-read",
+        schema={"name": NAME, "parameters": {"type": "object", "properties": {}}},
+        handler=broken_handler)
+    seen = []
+    try:
+        with capture_mcp_registry_misses(seen.append):
+            result = registry.dispatch(NAME, {})
+    finally:
+        registry.deregister(NAME)
+    assert "fixture handler failed" in json.loads(result)["error"]
+    assert seen == [], "a real handler failure must not masquerade as missing registry"
+
+
+def test_registry_miss_sink_exception_is_logged_and_context_is_reset(caplog):
+    def broken_sink(_name):
+        raise RuntimeError("fixture sink failed")
+
+    with capture_mcp_registry_misses(broken_sink):
