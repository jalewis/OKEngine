@@ -0,0 +1,164 @@
+"""OKEngine's vault boundary for Hermes file operations.
+
+The terminal backend, not the controller host, owns path resolution and symlinks.
+Probe there before mutating. The enforced okengine-write MCP remains the creation
+and structural-update path for Markdown pages in WIKI_PATH.
+"""
+
+import json
+import os
+import re
+from pathlib import Path
+from typing import Optional
+
+
+_READ_ECHO_CATN_RE = re.compile(r"^\s*\d+\|")
+_READ_ECHO_PIPE_FM_RE = re.compile(r"^\ufeff?\|+(?:---|[A-Za-z_][\w-]*:)")
+
+
+def read_echo_reject(content: str) -> Optional[str]:
+    if not content:
+        return None
+    lines = content.split("\n")
+    numbered = sum(1 for line in lines[:80] if _READ_ECHO_CATN_RE.match(line))
+    if numbered >= 2:
+        return "Read-tool line-number prefixes were echoed into the write; remove the NN| gutters"
+    if lines and _READ_ECHO_PIPE_FM_RE.match(lines[0]):
+        return "Read-tool pipe-prefixed frontmatter was echoed into the write; remove the leading |"
+    return None
+
+
+_PROBE = r'''
+import json, os, re, sys
+
+p = json.load(sys.stdin)
+path = p["path"]
+cwd = p["cwd"]
+root = p["root"]
+literal = os.path.abspath(path if os.path.isabs(path) else os.path.join(cwd, path))
+# Writes follow a final symlink; unlink/mv replace the link itself. In both
+# cases parent symlinks are resolved by the backend filesystem.
+target = (os.path.join(os.path.realpath(os.path.dirname(literal)), os.path.basename(literal))
+          if not p.get("follow_final_symlink", True) and os.path.islink(literal)
+          else os.path.realpath(literal))
+vault = os.path.realpath(root) if root else ""
+in_vault = bool(vault and (target == vault or target.startswith(vault + os.sep)))
+out = {"path": target, "in_vault": in_vault, "exists": os.path.exists(target),
+       "is_dir": os.path.isdir(target), "reserved": False,
+       "tombstoned": False, "schema_reason": None, "validator_unavailable": False}
+if in_vault and target.lower().endswith(".md"):
+    base = os.path.basename(target)
+    low = base.lower()
+    out["reserved"] = (low in {"log.md", "index.md", "agents.md", "hot.md",
+                               "readme.md", "health.md", "bundle.md"}
+                       or low.startswith("index-") or base.startswith(("_", ".")))
+    if os.path.isfile(target):
+        try:
+            with open(target, "r", encoding="utf-8", errors="replace") as fh:
+                head = fh.read(1000000)
+            fm = re.match(r"^\ufeff?---\r?\n(.*?)\r?\n---", head, re.DOTALL)
+            out["tombstoned"] = bool(fm and re.search(
+                r"(?im)^status:\s*[\"']?tombstoned\b", fm.group(1)))
+        except OSError:
+            out["validator_unavailable"] = True
+    try:
+        sys.path.insert(0, p["module_root"])
+        from tools.schema_validator import (
+            reserved_files_for, schema_reject_reason,
+            schema_reject_reason_for_link_replacement)
+        out["reserved"] = out["reserved"] or low in reserved_files_for(target)
+        if p.get("content") is not None:
+            check = (schema_reject_reason if p.get("follow_final_symlink", True)
+                     else schema_reject_reason_for_link_replacement)
+            out["schema_reason"] = check(target, p["content"])
+    except Exception:
+        out["validator_unavailable"] = True
+print(json.dumps(out))
+'''
+
+
+def _inspect(ops, path: str, content: Optional[str] = None, *,
+             follow_final_symlink: bool = True) -> tuple[Optional[dict], Optional[str]]:
+    root = os.environ.get("WIKI_PATH") or ""
+    if not root:
+        return {"in_vault": False, "is_dir": False}, None
+    payload = json.dumps({"path": path, "cwd": getattr(ops.env, "cwd", None) or ops.cwd,
+                          "root": root, "module_root": str(Path(__file__).resolve().parents[1]),
+                          "content": content, "follow_final_symlink": follow_final_symlink})
+    command = "python3" if ops._has_command("python3") else "python"
+    result = ops._exec(f"{command} -c {ops._escape_shell_arg(_PROBE)}", stdin_data=payload)
+    if result.exit_code != 0:
+        return None, "Vault write guard could not inspect the terminal backend target"
+    try:
+        state = json.loads(result.stdout.strip())
+    except (ValueError, TypeError):
+        return None, "Vault write guard received an invalid backend inspection"
+    required_bool = ("in_vault", "exists", "is_dir", "reserved",
+                     "tombstoned", "validator_unavailable")
+    if (not isinstance(state, dict)
+            or not isinstance(state.get("path"), str)
+            or any(not isinstance(state.get(key), bool) for key in required_bool)
+            or (state.get("schema_reason") is not None
+                and not isinstance(state.get("schema_reason"), str))):
+        return None, "Vault write guard received an incomplete backend inspection"
+    return state, None
+
+
+def _scoped_reject(ops, path: str, *, content: Optional[str] = None,
+                   creating: bool = False, follow_final_symlink: bool = True) -> Optional[str]:
+    state, error = _inspect(ops, path, content, follow_final_symlink=follow_final_symlink)
+    if error:
+        return error if os.environ.get("WIKI_PATH") else None
+    if not state["in_vault"] or not state["path"].lower().endswith(".md"):
+        return None
+    if state["reserved"]:
+        return "engine- or pack-reserved vault file is not agent-writable via the file tool"
+    if state["tombstoned"]:
+        return "tombstoned vault page is not agent-writable via the file tool"
+    if creating and not state["exists"]:
+        return "NEW vault page must be created through the okengine-write MCP, not the file tool"
+    if state["validator_unavailable"]:
+        return "Vault schema/reserved-file validator is unavailable on the terminal backend"
+    if state["schema_reason"]:
+        return f"Vault schema rejects the write: {state['schema_reason']}"
+    return None
+
+
+def write_reject(ops, path: str, content: str) -> Optional[str]:
+    return read_echo_reject(content) or _scoped_reject(ops, path, content=content, creating=True)
+
+
+def replace_reject(ops, path: str, new_string: str) -> Optional[str]:
+    return read_echo_reject(new_string) or _scoped_reject(ops, path)
+
+
+def delete_reject(ops, path: str) -> Optional[str]:
+    return _scoped_reject(ops, path, follow_final_symlink=False)
+
+
+def move_reject(ops, src: str, dst: str) -> Optional[str]:
+    source_error = _scoped_reject(ops, src, follow_final_symlink=False)
+    if source_error:
+        return source_error
+    destination, error = _inspect(ops, dst, follow_final_symlink=False)
+    if error:
+        return error if os.environ.get("WIKI_PATH") else None
+    effective_dst = (
+        os.path.join(dst, os.path.basename(os.path.normpath(src)))
+        if destination["is_dir"] else dst)
+    destination, error = _inspect(ops, effective_dst, follow_final_symlink=False)
+    if error:
+        return error if os.environ.get("WIKI_PATH") else None
+    content = None
+    if destination["in_vault"] and destination["path"].lower().endswith(".md") and destination["exists"]:
+        # Replacing an existing page via mv is a write, not merely a rename:
+        # validate the source bytes against the destination's governing schema.
+        read_result = ops._cat(src)
+        if read_result.exit_code != 0:
+            return "Vault move guard could not read the source page before replacement"
+        content = read_result.stdout
+        echo = read_echo_reject(content)
+        if echo:
+            return echo
+    return _scoped_reject(ops, effective_dst, content=content, creating=True,
+                          follow_final_symlink=False)
