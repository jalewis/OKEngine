+    monkeypatch.setenv("HERMES_WRITE_SAFE_ROOT", str(allowed))
+    monkeypatch.delenv("WIKI_PATH", raising=False)
+    ops = ShellFileOperations(RealBackend(tmp_path))
+    source = allowed / "source.txt"
+    source.write_text("retain source\n", encoding="utf-8")
+    outside = tmp_path / "outside.txt"
+
+    write = ops.write_file(str(outside), "must not appear\n")
+    moved = ops.move_file(str(source), str(outside))
+    deleted = ops.delete_file(str(outside))
+
+    assert write.error and "safe" in write.error.lower(), write
+    assert moved.error and "safe" in moved.error.lower(), moved
+    assert deleted.error and "safe" in deleted.error.lower(), deleted
+    assert source.read_text(encoding="utf-8") == "retain source\n"
+    assert not outside.exists()
+
