@@ -0,0 +1,411 @@
+"""OKEngine vault-file guards at real ShellFileOperations boundaries."""
+
+import json
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from tools.file_operations import ShellFileOperations
+from tools.file_operations_okengine_guard import read_echo_reject
+
+
+class RealBackend:
+    def __init__(self, cwd):
+        self.cwd = str(cwd)
+
+    def execute(self, command, *, cwd=None, stdin_data=None, **_kwargs):
+        result = subprocess.run(command, shell=True, cwd=cwd or self.cwd,
+                                input=stdin_data.encode("utf-8") if stdin_data is not None else None,
+                                capture_output=True, check=False)
+        return {"output": result.stdout.decode("utf-8"), "returncode": result.returncode}
+
+
+class MalformedProbeBackend(RealBackend):
+    def execute(self, command, *, cwd=None, stdin_data=None, **kwargs):
+        if command.startswith("python3 -c "):
+            return {"output": '{"in_vault": true}', "returncode": 0}
+        return super().execute(command, cwd=cwd, stdin_data=stdin_data, **kwargs)
+
+
+class FailedProbeBackend(RealBackend):
+    def execute(self, command, *, cwd=None, stdin_data=None, **kwargs):
+        if command.startswith(("python3 -c ", "python -c ")):
+            return {"output": "", "returncode": 7}
+        return super().execute(command, cwd=cwd, stdin_data=stdin_data, **kwargs)
+
+
+class InvalidJsonProbeBackend(RealBackend):
+    def execute(self, command, *, cwd=None, stdin_data=None, **kwargs):
+        if command.startswith(("python3 -c ", "python -c ")):
+            return {"output": "{not-json", "returncode": 0}
+        return super().execute(command, cwd=cwd, stdin_data=stdin_data, **kwargs)
+
+
+class ValidatorUnavailableBackend(RealBackend):
+    def execute(self, command, *, cwd=None, stdin_data=None, **kwargs):
+        result = super().execute(command, cwd=cwd, stdin_data=stdin_data, **kwargs)
+        if command.startswith(("python3 -c ", "python -c ")) and result["returncode"] == 0:
+            state = json.loads(result["output"])
+            state["validator_unavailable"] = True
+            result["output"] = json.dumps(state)
+        return result
+
+
+class FailNthProbeBackend(RealBackend):
+    def __init__(self, cwd, nth):
+        super().__init__(cwd)
+        self.nth = nth
+        self.seen = 0
+
+    def execute(self, command, *, cwd=None, stdin_data=None, **kwargs):
+        if command.startswith(("python3 -c ", "python -c ")):
+            self.seen += 1
+            if self.seen == self.nth:
+                return {"output": "", "returncode": 7}
+        return super().execute(command, cwd=cwd, stdin_data=stdin_data, **kwargs)
+
+
+class CatFailureBackend(RealBackend):
+    def execute(self, command, *, cwd=None, stdin_data=None, **kwargs):
+        if command.startswith("cat "):
+            return {"output": "", "returncode": 1}
+        return super().execute(command, cwd=cwd, stdin_data=stdin_data, **kwargs)
+
+
+@pytest.fixture
+def vault_ops(tmp_path, monkeypatch):
+    vault = tmp_path / "vault"
+    wiki = vault / "wiki"
+    wiki.mkdir(parents=True)
+    monkeypatch.setenv("WIKI_PATH", str(vault))
+    monkeypatch.setenv("HERMES_WRITE_SAFE_ROOT", str(tmp_path))
+    monkeypatch.setenv("OKENGINE_BASE_SCHEMA", str(Path(__file__).parents[2] / "config" / "base-schema.yaml"))
+    ops = ShellFileOperations(RealBackend(wiki))
+    return vault, wiki, ops
+
+
+def test_new_vault_page_is_not_created_by_file_tool(vault_ops):
+    _vault, wiki, ops = vault_ops
+    target = wiki / "concepts" / "new.md"
+    result = ops.write_file(str(target), "---\ntype: concept\n---\n")
+    assert result.error and "NEW vault page" in result.error
+    assert not target.exists()
+
+
+def test_engine_reserved_page_cannot_be_deleted_or_moved(vault_ops):
+    _vault, wiki, ops = vault_ops
+    page = wiki / "HOT.md"
+    page.write_text("dashboard\n", encoding="utf-8")
+    delete_result = ops.delete_file(str(page))
+    move_result = ops.move_file(str(page), str(wiki / "other.md"))
+    assert delete_result.error and "reserved" in delete_result.error
+    assert move_result.error and "reserved" in move_result.error
+    assert page.exists() and not (wiki / "other.md").exists()
+
+
+def test_symlink_alias_uses_backend_resolved_reserved_target(vault_ops):
+    vault, wiki, ops = vault_ops
+    page = wiki / "HOT.md"
+    page.write_text("dashboard\n", encoding="utf-8")
+    alias = vault.parent / "innocent.txt"
+    alias.symlink_to(page)
+    result = ops.write_file(str(alias), "overwrite\n")
+    assert result.error and "reserved" in result.error
+    assert page.read_text(encoding="utf-8") == "dashboard\n"
+
+
+def test_pack_reserved_and_tombstoned_pages_are_not_agent_writable(vault_ops):
+    _vault, wiki, ops = vault_ops
+    (wiki / "schema.yaml").write_text("reserved_files: [secret.md]\n", encoding="utf-8")
+    reserved = wiki / "secret.md"
+    reserved.write_text("protected\n", encoding="utf-8")
+    tombstone = wiki / "old.md"
+    tombstone.write_text("---\ntype: entity\nstatus: tombstoned\n---\nold\n", encoding="utf-8")
+    assert "reserved" in (ops.write_file(str(reserved), "new\n").error or "")
+    assert "tombstoned" in (ops.patch_replace(str(tombstone), "old", "new").error or "")
+    assert tombstone.read_text(encoding="utf-8").endswith("old\n")
+
+
+def test_schema_rejection_preserves_existing_page_and_valid_edit_succeeds(vault_ops):
+    _vault, wiki, ops = vault_ops
+    (wiki / "schema.yaml").write_text(
+        "types:\n  entity: {required: [type, id]}\n", encoding="utf-8")
+    page = wiki / "item.md"
+    original = "---\ntype: entity\nid: entity:item\n---\nold\n"
+    page.write_text(original, encoding="utf-8")
+    rejected = ops.write_file(str(page), "---\ntype: entity\n---\nbad\n")
+    assert rejected.error and "schema" in rejected.error.lower()
+    assert page.read_text(encoding="utf-8") == original
+    accepted = ops.write_file(str(page), original.replace("old", "new"))
+    assert accepted.error is None and page.read_text(encoding="utf-8").endswith("new\n")
+
+
+def test_read_echo_is_rejected_but_markdown_table_is_safe(vault_ops):
+    vault, _wiki, ops = vault_ops
+    outside = vault.parent / "report.txt"
+    result = ops.write_file(str(outside), "1|line\n2|line\n")
+    assert result.error and "line-number" in result.error
+    assert not outside.exists()
+    good = ops.write_file(str(outside), "| col | value |\n| --- | --- |\n")
+    assert good.error is None
+
+
+def test_empty_read_echo_content_is_not_a_false_positive():
+    assert read_echo_reject("") is None
+
+
+def test_pipe_frontmatter_echo_is_rejected_without_false_positive_on_one_gutter(vault_ops):
+    vault, _wiki, ops = vault_ops
+    outside = vault.parent / "scratch.txt"
+    pipe = ops.write_file(str(outside), "|---\n|type: entity\n")
+    assert pipe.error and "pipe-prefixed" in pipe.error
+    assert not outside.exists()
+    one = ops.write_file(str(outside), "1|just one numbered example\nordinary line\n")
+    assert one.error is None
+
+
+def test_move_into_new_vault_page_is_refused_at_effective_destination(vault_ops):
+    vault, wiki, ops = vault_ops
+    source = vault.parent / "draft.md"
+    source.write_text("draft\n", encoding="utf-8")
+    result = ops.move_file(str(source), str(wiki))
+    assert result.error and "NEW vault page" in result.error
+    assert source.exists() and not (wiki / "draft.md").exists()
+
+
+def test_relative_path_uses_backend_cwd_not_controller_cwd(vault_ops, monkeypatch, tmp_path):
+    _vault, wiki, ops = vault_ops
+    (wiki / "HOT.md").write_text("dashboard\n", encoding="utf-8")
+    decoy = tmp_path / "controller-cwd"
+    decoy.mkdir()
+    monkeypatch.chdir(decoy)
+    result = ops.write_file("HOT.md", "overwrite\n")
+    assert result.error and "reserved" in result.error
+    assert (wiki / "HOT.md").read_text(encoding="utf-8") == "dashboard\n"
+
+
+def test_incomplete_backend_probe_fails_closed_without_mutation(vault_ops):
+    _vault, wiki, _ops = vault_ops
+    ops = ShellFileOperations(MalformedProbeBackend(wiki))
+    target = wiki / "item.md"
+    target.write_text("old\n", encoding="utf-8")
+    result = ops.write_file(str(target), "new\n")
+    assert result.error and "incomplete backend inspection" in result.error
+    assert target.read_text(encoding="utf-8") == "old\n"
+
+
+def test_backend_probe_nonzero_exit_blocks_existing_vault_write(vault_ops):
+    _vault, wiki, _ops = vault_ops
+    ops = ShellFileOperations(FailedProbeBackend(wiki))
+    target = wiki / "item.md"
+    target.write_text("old\n", encoding="utf-8")
+    result = ops.write_file(str(target), "new\n")
+    assert result.error and "could not inspect" in result.error
+    assert target.read_text(encoding="utf-8") == "old\n"
+
+
+def test_backend_probe_invalid_json_blocks_existing_vault_write(vault_ops):
+    _vault, wiki, _ops = vault_ops
+    ops = ShellFileOperations(InvalidJsonProbeBackend(wiki))
+    target = wiki / "item.md"
+    target.write_text("old\n", encoding="utf-8")
+    result = ops.write_file(str(target), "new\n")
+    assert result.error and "invalid backend inspection" in result.error
+    assert target.read_text(encoding="utf-8") == "old\n"
+
+
+def test_backend_validator_unavailable_blocks_existing_vault_write(vault_ops):
+    _vault, wiki, _ops = vault_ops
+    ops = ShellFileOperations(ValidatorUnavailableBackend(wiki))
+    target = wiki / "item.md"
+    target.write_text("old\n", encoding="utf-8")
+    result = ops.write_file(str(target), "new\n")
+    assert result.error and "validator is unavailable" in result.error
+    assert target.read_text(encoding="utf-8") == "old\n"
+
+
+@pytest.mark.parametrize("failed_probe", [2, 3])
+def test_move_probe_failure_preserves_source_and_effective_destination(vault_ops, failed_probe):
+    vault, wiki, _ops = vault_ops
+    source = vault.parent / "draft.md"
+    source.write_text("retain\n", encoding="utf-8")
+    ops = ShellFileOperations(FailNthProbeBackend(wiki, failed_probe))
+    result = ops.move_file(str(source), str(wiki))
+    assert result.error and "Vault write guard" in result.error
+    assert source.read_text(encoding="utf-8") == "retain\n"
+    assert not (wiki / "draft.md").exists()
+
+
+def test_no_configured_vault_keeps_native_file_write_behavior(vault_ops, monkeypatch):
+    _vault, wiki, ops = vault_ops
+    monkeypatch.delenv("WIKI_PATH")
+    target = wiki / "ordinary.md"
+    result = ops.write_file(str(target), "ordinary\n")
+    assert result.error is None and target.read_text(encoding="utf-8") == "ordinary\n"
+
+
+def test_nonvault_move_and_delete_use_real_backend_on_disposable_files(vault_ops):
+    vault, _wiki, ops = vault_ops
+    source = vault.parent / "move-source.txt"
+    destination = vault.parent / "move-destination.txt"
+    source.write_text("disposable content\n", encoding="utf-8")
+    moved = ops.move_file(str(source), str(destination))
+    assert moved.error is None
+    assert not source.exists() and destination.read_text(encoding="utf-8") == "disposable content\n"
+    deleted = ops.delete_file(str(destination))
+    assert deleted.error is None and not destination.exists()
+
+
+def test_nonvault_delete_refuses_directory_but_missing_file_is_idempotent(vault_ops):
+    vault, _wiki, ops = vault_ops
+    directory = vault.parent / "disposable-directory"
+    directory.mkdir()
+    refused = ops.delete_file(str(directory))
+    assert refused.error and directory.is_dir(), (
+        "native delete must not recursively remove a directory")
+    missing = vault.parent / "missing-disposable.txt"
