diff --git a/tests/agent/test_http_status_policy.py b/tests/agent/test_http_status_policy.py
new file mode 100644
index 000000000..f88955512
--- /dev/null
+++ b/tests/agent/test_http_status_policy.py
@@ -0,0 +1,717 @@
+"""Local pool HTTP status contracts on the real agent and retry surfaces."""
+
+import json
+import ssl
+
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from run_agent import AIAgent
+
+
+class _HTTPError(Exception):
+    def __init__(self, status):
+        super().__init__(f"Error code: {status} - local pool capacity")
+        self.status_code = status
+        self.response = SimpleNamespace(headers={})
+        self.body = {"error": {"message": "local pool capacity"}}
+
+
+class _ContextOverflowError(Exception):
+    def __init__(self):
+        message = (
+            "This model's maximum context length is 128000 tokens. "
+            "However, you requested 140000 tokens."
+        )
+        super().__init__(message)
+        self.status_code = 400
+        self.response = SimpleNamespace(headers={})
+        self.body = {"error": {"message": message}}
+
+
+class _WrappedOutputCapError(Exception):
+    def __init__(self):
+        message = (
+            "Error code: 429 - [400]: max_tokens (32768) exceeds "
+            "model maximum output tokens (8192)"
+        )
+        super().__init__(message)
+        self.status_code = 429
+        self.response = SimpleNamespace(headers={})
+        self.body = {"error": {"message": message}}
+
+
+def _agent(config, *, fallback_model=None, model="qwen3-coder:30b"):
+    with (
+        patch("hermes_cli.config.load_config_readonly", autospec=True, return_value=config),
+        patch("model_tools.get_tool_definitions", autospec=True, return_value=[]),
+        patch("model_tools.check_toolset_requirements", autospec=True, return_value={}),
+        patch("agent.process_bootstrap.OpenAI", autospec=True),
+    ):
+        return AIAgent(
+            api_key="fixture-key", base_url="http://127.0.0.1:11436/v1",
+            provider="custom", model=model, max_iterations=2,
+            quiet_mode=True, skip_context_files=True, skip_memory=True,
+            fallback_model=fallback_model,
+        )
+
+
+def test_documented_local_pool_policy_sets_total_attempt_ceiling():
+    agent = _agent({"agent": {
+        "api_max_retries": 3,
+        "http_status_policy": {
+            404: {"max_attempts": 1, "fallback": False},
+            500: {"max_attempts": 2, "fallback": False},
+            503: {"max_attempts": 6, "fallback": False},
+            504: {"max_attempts": 1, "fallback": False},
+        },
+    }})
+    assert agent._api_max_retries == 3
+    assert agent._api_retry_loop_ceiling == 6
+    assert agent._http_status_policy == {
+        "404": {"max_attempts": 1, "fallback": False},
+        "500": {"max_attempts": 2, "fallback": False},
+        "503": {"max_attempts": 6, "fallback": False},
+        "504": {"max_attempts": 1, "fallback": False},
+    }
+
+
+@pytest.mark.parametrize(
+    "bad_rule",
+    [
+        {"max_attempts": 0, "fallback": False},
+        {"max_attempts": True, "fallback": False},
+        {"max_attempts": 1.5, "fallback": False},
+        {"max_attempts": "nope", "fallback": False},
+        {"max_attempts": 2, "fallback": "false"},
+    ],
+)
+def test_invalid_status_rule_does_not_expand_or_change_fallback(bad_rule):
+    agent = _agent({"agent": {
+        "api_max_retries": 3,
+        "http_status_policy": {503: bad_rule},
+    }})
+    assert agent._http_status_policy == {}
+    assert agent._api_retry_loop_ceiling == 3
+
+
+@pytest.mark.parametrize(
+    "bad_policy",
+    [None, [], "503", {True: {"max_attempts": 6, "fallback": False}},
+     {99: {"max_attempts": 6, "fallback": False}},
+     {600: {"max_attempts": 6, "fallback": False}},
+     {503.5: {"max_attempts": 6, "fallback": False}},
+     {503: None}],
+)
+def test_invalid_policy_or_status_key_cannot_expand_attempts(bad_policy):
+    agent = _agent({"agent": {
+        "api_max_retries": 3,
+        "http_status_policy": bad_policy,
+    }})
+    assert agent._http_status_policy == {}
+    assert agent._api_retry_loop_ceiling == 3
+
+
+def test_missing_optional_status_fields_keep_generic_attempts_and_default_fallback():
+    agent = _agent({"agent": {
+        "api_max_retries": 3,
+        "http_status_policy": {503: {}},
+    }})
+    assert agent._http_status_policy == {
+        "503": {"max_attempts": 3, "fallback": True},
+    }
+    assert agent._api_retry_loop_ceiling == 3
+
+
+def test_503_retries_six_total_requests_without_paid_fallback():
+    config = {"agent": {
+        "api_max_retries": 3,
+        "http_status_policy": {503: {"max_attempts": 6, "fallback": False}},
+    }}
+    agent = _agent(config, fallback_model=[{"provider": "openrouter", "model": "gpt-4o"}])
+    attempts = []
+
+    def _failed_request(_kwargs):
