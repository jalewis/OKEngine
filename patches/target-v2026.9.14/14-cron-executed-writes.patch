diff --git a/tests/tools/test_okengine_write_telemetry.py b/tests/tools/test_okengine_write_telemetry.py
new file mode 100644
index 000000000..937e7d8a3
--- /dev/null
+++ b/tests/tools/test_okengine_write_telemetry.py
@@ -0,0 +1,139 @@
+"""Write receipts require dispatched OKEngine MCP success, not turn prose."""
+
+import concurrent.futures
+import json
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from tools.okengine_write_telemetry import (
+    capture_okengine_writes, parse_okengine_write_result,
+    record_okengine_write_result)
+from tools.registry import ToolRegistry
+from tools.mcp_tool_handlers import _render_call_tool_result
+from tools.thread_context import propagate_context_to_thread
+
+NAME = "mcp__okengine_write__create_entity"
+
+
+@pytest.mark.parametrize("text,operation,path,version", [
+    ("created entities/shard/one.md v1", "created", "entities/shard/one.md", 1),
+    ("updated entities/shard/one.md v12 (id one)", "updated", "entities/shard/one.md", 12),
+    ("patched entities/shard/one.md v13 (review flagged)", "patched", "entities/shard/one.md", 13),
+    ("tombstoned entities/shard/one.md v14 (file retained, not deleted)",
+     "tombstoned", "entities/shard/one.md", 14),
+    ("appended to 'Evidence' in entities/shard/one.md v15 (section exists)",
+     "appended", "entities/shard/one.md", 15),
+    ("converged into entities/shard/one.md (id one) v16: +1 added",
+     "converged", "entities/shard/one.md", 16),
+])
+def test_write_server_success_forms_preserve_canonical_path(text, operation, path, version):
+    receipt = parse_okengine_write_result(NAME, json.dumps({"result": text}))
+    assert receipt == {"operation": operation, "path": path,
+                       "version": version, "tool": NAME}
+
+
+@pytest.mark.parametrize("name,result", [
+    ("mcp__other__create_entity", '{"result":"created entities/a.md v1"}'),
+    ("mcp__okengine_writer__create_entity", '{"result":"created entities/a.md v1"}'),
+    (NAME, '{"error":"not connected"}'),
+    (NAME, '{"result":"refused: created entities/a.md v1"}'),
+    (NAME, '{"result":"created ../outside.md v1"}'),
+    (NAME, '{"result":"created /absolute.md v1"}'),
+    (NAME, '{"result":"created entities//bad.md v1"}'),
+    (NAME, '{"result":"created entities/./bad.md v1"}'),
+    (NAME, '{"result":"created entities/../bad.md v1"}'),
+    (NAME, '{"result":"created entities\\\\bad.md v1"}'),
+    (NAME, '{"result":null}'),
+    (NAME, '{"result":42}'),
+    (NAME, '{"result":[]}'),
+    (NAME, '{"result":"created entities/a.md v0"}'),
+    (NAME, '{"result":"created entities/a.md v9999999999999999999"}'),
+    (NAME, '{"result":"created entities/a.md v1suffix"}'),
+    (NAME, "not json"),
+])
+def test_nonwrite_error_or_unsafe_path_cannot_make_receipt(name, result):
+    assert parse_okengine_write_result(name, result) is None
+
+
+def test_real_mcp_result_renderer_contract_reaches_write_parser():
+    success = SimpleNamespace(
+        content=[SimpleNamespace(type="text", text="created entities/shard/one.md v3")],
+        isError=False, structuredContent=None, meta=None)
+    rejected = SimpleNamespace(
+        content=[SimpleNamespace(type="text", text="created entities/shard/one.md v3")],
+        isError=True, structuredContent=None, meta=None)
+    assert parse_okengine_write_result(
+        NAME, _render_call_tool_result(success, "okengine-write"))["version"] == 3
+    assert parse_okengine_write_result(
+        NAME, _render_call_tool_result(rejected, "okengine-write")) is None
+
+
+def _registry(handler):
+    registry = ToolRegistry()
+    registry.register(
+        name=NAME, toolset="fixture",
+        schema={"name": NAME, "description": "disposable fixture",
+                "parameters": {"type": "object", "properties": {}}},
+        handler=handler,
+    )
+    return registry
+
+
+def test_registry_records_success_result_but_not_application_error():
+    calls = []
+
+    def handler(args, **_kwargs):
+        calls.append(args)
+        if args.get("error"):
+            return '{"error":"write refused"}'
+        return '{"result":"created entities/shard/canonical.md v2"}'
+
+    registry = _registry(handler)
+    writes = []
+    with capture_okengine_writes(writes.append):
+        assert json.loads(registry.dispatch(NAME, {"requested": "entities/flat.md"}))["result"]
+        assert "error" in json.loads(registry.dispatch(NAME, {"error": True}))
+    assert calls == [{"requested": "entities/flat.md"}, {"error": True}]
+    assert writes == [{"operation": "created", "path": "entities/shard/canonical.md",
+                       "version": 2, "tool": NAME}], (
+        "the returned canonical path, not the model's requested flat path, must be recorded")
+    registry.dispatch(NAME, {})
+    assert len(writes) == 1, "the sink must reset outside the cron fire"
+
+
+def test_telemetry_sink_exception_does_not_retry_committed_write(caplog):
+    calls = []
+
+    def handler(args, **_kwargs):
+        calls.append(args)
+        return '{"result":"created entities/shard/canonical.md v2"}'
+
+    def broken_sink(_receipt):
+        raise RuntimeError("disposable sink failure")
+
+    registry = _registry(handler)
+    with capture_okengine_writes(broken_sink):
+        result = registry.dispatch(NAME, {"requested": "entities/flat.md"})
+    assert json.loads(result)["result"] == "created entities/shard/canonical.md v2"
+    assert calls == [{"requested": "entities/flat.md"}], (
+        "telemetry failure must not cause a second committed MCP write")
+    assert any("write telemetry sink failed" in row.message for row in caplog.records)
+
+
+def test_parallel_registry_write_results_are_scoped_to_one_fire():
+    registry = _registry(lambda _args, **_kwargs: '{"result":"created entities/a.md v1"}')
+    writes = []
+    lock = threading.Lock()
+
+    def record(receipt):
+        with lock:
+            writes.append(receipt)
+
+    with capture_okengine_writes(record):
+        with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
+            futures = [pool.submit(propagate_context_to_thread(registry.dispatch), NAME, {})
+                       for _ in range(20)]
+            assert all("result" in json.loads(f.result()) for f in futures)
+    assert len(writes) == 20
diff --git a/tools/okengine_write_telemetry.py b/tools/okengine_write_telemetry.py
new file mode 100644
index 000000000..6cb540be9
--- /dev/null
+++ b/tools/okengine_write_telemetry.py
@@ -0,0 +1,88 @@
+"""Execution-time OKEngine MCP write receipts for one cron fire.
+
+The MCP write server's result is the canonical post-shard path. Model-authored
+messages and later-compacted turn history are never evidence of a write.
+"""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+import json
+import logging
+import re
+from typing import Callable, Iterator, Optional
+
+logger = logging.getLogger(__name__)
+_write_sink: ContextVar[Optional[Callable[[dict], None]]] = ContextVar(
+    "hermes_okengine_executed_write_sink", default=None)
+
+_DIRECT = re.compile(
+    r"\A(?P<operation>created|updated|patched|tombstoned) "
+    r"(?P<path>[^\s]+) v(?P<version>[1-9][0-9]{0,17})(?=\s|$)")
+_APPEND = re.compile(
+    r"\Aappended to '[^\n']*' in (?P<path>[^\s]+) "
+    r"v(?P<version>[1-9][0-9]{0,17})(?=\s|$)")
+_CONVERGE = re.compile(
+    r"\Aconverged into (?P<path>[^\s]+) \(id [^)]+\) "
+    r"v(?P<version>[1-9][0-9]{0,17})(?=:|\s|$)")
+
+
+@contextmanager
+def capture_okengine_writes(sink: Callable[[dict], None]) -> Iterator[None]:
+    token = _write_sink.set(sink)
+    try:
+        yield
+    finally:
+        _write_sink.reset(token)
+
+
+def _canonical_path(raw: str) -> str | None:
+    if (not raw or raw.startswith("/") or "\\" in raw or "//" in raw
+            or raw.endswith("/")):
+        return None
+    if any(part in {"", ".", ".."} for part in raw.split("/")):
+        return None
+    return raw
+
+
+def parse_okengine_write_result(name: str, result: object) -> dict | None:
+    """Accept an exact write-server success line from a dispatched MCP result."""
+    parts = name.split("__", 2) if isinstance(name, str) else []
+    if (len(parts) != 3 or parts[0] != "mcp"
+            or not (parts[1] == "okengine_write"
+                    or parts[1].startswith("okengine_write_"))):
+        return None
+    try:
+        payload = json.loads(result) if isinstance(result, str) else result
+    except (TypeError, ValueError):
+        return None
+    if not isinstance(payload, dict) or "error" in payload:
+        return None
+    text = payload.get("result")
+    if not isinstance(text, str):
+        return None
+    # No search: a note or model-like preamble mentioning a success line is not
+    # a write-server acknowledgement. Never trust the requested argument path.
+    hit = _DIRECT.match(text) or _APPEND.match(text) or _CONVERGE.match(text)
+    if hit is None:
+        return None
+    path = _canonical_path(hit.group("path"))
+    if path is None:
+        return None
+    operation = hit.groupdict().get("operation") or (
+        "appended" if hit.re is _APPEND else "converged")
+    return {"operation": operation, "path": path,
+            "version": int(hit.group("version")), "tool": name}
+
+
+def record_okengine_write_result(name: str, result: object) -> None:
+    sink = _write_sink.get()
+    if sink is None:
+        return
+    receipt = parse_okengine_write_result(name, result)
+    if receipt is None:
+        return
+    try:
+        sink(receipt)
+    except Exception:
+        # A telemetry failure must not retry a write that already committed.
+        logger.exception("OKEngine write telemetry sink failed for %s", name)
