diff --git a/tests/test_read_only_file_toolsets.py b/tests/test_read_only_file_toolsets.py
new file mode 100644
index 000000000..edf1bb04a
--- /dev/null
+++ b/tests/test_read_only_file_toolsets.py
@@ -0,0 +1,73 @@
+"""The file subsets must stay closed after registry and runtime expansion."""
+
+from types import SimpleNamespace
+
+import pytest
+
+import toolsets
+from hermes_cli.tools_config import CONFIGURABLE_TOOLSETS, _get_platform_tools
+
+
+@pytest.mark.parametrize(
+    ("name", "expected"),
+    [
+        ("file_read", {"read_file", "search_files"}),
+        ("file_read_exact", {"read_file"}),
+    ],
+)
+def test_read_only_file_toolsets_resolve_only_their_declared_tools(name, expected):
+    assert name in {key for key, _, _ in CONFIGURABLE_TOOLSETS}
+    assert set(toolsets.resolve_toolset(name)) == expected
+
+
+@pytest.mark.parametrize(
+    ("name", "expected"),
+    [
+        ("file_read", {"read_file", "search_files"}),
+        ("file_read_exact", {"read_file"}),
+    ],
+)
+def test_registry_and_alias_cannot_inject_mutation_tools(monkeypatch, name, expected):
+    registry = SimpleNamespace(
+        _generation=37,
+        get_tool_names_for_toolset=lambda key: (
+            ["write_file", "patch", "delete_file", "search_files"]
+            if key == name else ["write_file", "delete_file"]
+        ),
+        get_toolset_alias_target=lambda key: "mcp-danger" if key == name else None,
+        current_scope_key=lambda: "injection-fixture",
+    )
+    monkeypatch.setattr(toolsets, "_registry", lambda: registry)
+
+    # The unfiltered registry surface is deliberately hostile; exercise the
+    # same default resolver used by model_tools, not the static-only view.
+    assert "write_file" in toolsets.get_toolset(name)["tools"]
+    assert set(toolsets.resolve_toolset(name)) == expected
+    assert set(toolsets.resolve_toolset(name)) == expected  # memoized path
+
+
+def test_explicit_read_only_platform_selection_does_not_recover_file():
+    enabled = _get_platform_tools({"platform_toolsets": {"cli": ["file_read"]}}, "cli")
+    assert "file_read" in enabled
+    assert "file" not in enabled
+
+
+def test_mixed_file_selection_is_not_a_read_only_policy():
+    from model_tools import _select_tool_names
+
+    selected = _select_tool_names(["file_read", "file"], None, quiet_mode=True)
+    assert {"write_file", "patch"} <= selected
+    assert {"read_file", "search_files"} <= selected
+
+
+@pytest.mark.parametrize("wildcard", ["all", "*"])
+def test_wildcard_includes_new_toolset_and_terminates_include_cycle(monkeypatch, wildcard):
+    monkeypatch.setattr(toolsets, "TOOLSETS", dict(toolsets.TOOLSETS))
+    toolsets.create_custom_toolset("zz-alpha", "fixture", ["read_file"], ["zz-beta"])
+    toolsets.create_custom_toolset("zz-beta", "fixture", ["search_files"], ["zz-alpha"])
+    toolsets.create_custom_toolset("zz-future", "fixture", ["future_read"])
+
+    # Exercise the public external-call path, not just the internal recursive path.
+    resolved = toolsets.resolve_toolset(wildcard, include_registry=False)
+    assert {"read_file", "search_files", "future_read"} <= set(resolved), resolved
+    assert resolved == sorted(set(resolved)), "wildcard resolution must be unique and sorted"
