diff --git a/tests/cron/test_okengine_mcp_scope.py b/tests/cron/test_okengine_mcp_scope.py
new file mode 100644
index 000000000..58770b1f0
--- /dev/null
+++ b/tests/cron/test_okengine_mcp_scope.py
@@ -0,0 +1,104 @@
+"""Cron's MCP allowlist and required surfaces are verified before agent spend."""
+
+from unittest.mock import patch
+
+import pytest
+
+from cron.scheduler import (
+    _init_cron_mcp_tools, _resolve_cron_enabled_toolsets,
+)
+
+
+CFG = {"mcp_servers": {
+    "okengine-read": {"url": "http://127.0.0.1:9001"},
+    "okengine-write": {"url": "http://127.0.0.1:9002"},
+    "okengine-write-domain-enrichment-classification-worker": {
+        "command": "python", "args": ["writer.py"],
+    },
+    "unrelated": {"url": "http://127.0.0.1:9003"},
+}}
+
+
+def test_explicit_empty_and_no_mcp_never_inherit_configured_servers():
+    assert _resolve_cron_enabled_toolsets({"enabled_toolsets": []}, CFG) == []
+    assert _resolve_cron_enabled_toolsets({"enabled_toolsets": ["no_mcp"]}, CFG) == []
+    with patch("tools.mcp_tool_discovery.discover_mcp_tools", autospec=True,
+               return_value=[]) as discover:
+        assert _init_cron_mcp_tools("empty", [], CFG) == []
+    discover.assert_called_once_with([])
+
+
+def test_builtin_only_job_allowlist_does_not_add_global_read_or_write():
+    assert _resolve_cron_enabled_toolsets({"enabled_toolsets": ["terminal"]}, CFG) == [
+        "terminal"]
+    assert _resolve_cron_enabled_toolsets(
+        {"enabled_toolsets": ["terminal", "okengine-read"]}, CFG
+    ) == ["terminal", "okengine-read"]
+
+
+@pytest.mark.parametrize("value", [None, "okengine-read", [None], [""], [42], {}])
+def test_malformed_job_allowlist_refuses_full_default(value):
+    with pytest.raises(RuntimeError, match="explicit list"):
+        _resolve_cron_enabled_toolsets({"enabled_toolsets": value}, CFG)
+
+
+def test_discovery_receives_only_the_resolved_job_allowlist():
+    admitted = ["terminal", "okengine-read"]
+    with patch("tools.mcp_tool_discovery.discover_mcp_tools", autospec=True,
+               return_value=["mcp__okengine_read__get_page"]) as discover:
+        assert _init_cron_mcp_tools("reader", admitted, CFG) == [
+            "mcp__okengine_read__get_page"]
+    discover.assert_called_once_with(admitted)
+
+
+def test_hashed_physical_tool_satisfies_its_exact_required_server_toolset():
+    server = "okengine-write-domain-enrichment-classification-worker"
+    physical_name = "mcp__okengine_write_domain_enrichment_classification_wo_371f8f3a"
+    with (
+        patch("tools.mcp_tool_discovery.discover_mcp_tools", autospec=True,
+              return_value=[physical_name]) as discover,
+        patch("toolsets.resolve_toolset", autospec=True,
+              return_value=[physical_name]) as resolve,
+        patch("tools.registry.registry.get_entry", autospec=True,
+              return_value=object()),
+    ):
+        assert _init_cron_mcp_tools("long-writer", [server], CFG) == [physical_name]
+    discover.assert_called_once_with([server])
+    resolve.assert_called_once_with(server)
+
+
+def test_unrelated_connected_server_cannot_satisfy_required_reader():
+    with patch("tools.mcp_tool_discovery.discover_mcp_tools", autospec=True,
+               return_value=["mcp__unrelated__search"]) as discover:
+        with pytest.raises(RuntimeError, match="okengine-read.*canonical tools"):
+            _init_cron_mcp_tools("reader", ["okengine-read"], CFG)
+    discover.assert_called_once_with(["okengine-read"])
+
+
+def test_one_required_surface_does_not_cover_another():
+    with patch("tools.mcp_tool_discovery.discover_mcp_tools", autospec=True,
+               return_value=["mcp__okengine_read__get_page"]):
+        with pytest.raises(RuntimeError, match="okengine-write.*canonical tools"):
+            _init_cron_mcp_tools("writer", ["okengine-read", "okengine-write"], CFG)
+
+
+def test_discovery_failure_is_fatal_only_for_required_surface():
+    with patch("tools.mcp_tool_discovery.discover_mcp_tools", autospec=True,
+               side_effect=OSError("disposable disconnect")):
+        with pytest.raises(RuntimeError, match="requires MCP"):
+            _init_cron_mcp_tools("reader", ["okengine-read"], CFG)
+        assert _init_cron_mcp_tools("local", ["terminal"], CFG) == []
+
+
+def test_missing_config_cannot_make_an_okengine_surface_optional():
+    with patch("tools.mcp_tool_discovery.discover_mcp_tools", autospec=True,
+               return_value=[]):
+        with pytest.raises(RuntimeError, match="okengine-write.*canonical tools"):
+            _init_cron_mcp_tools("writer", ["okengine-write"], {})
+
+
+def test_platform_toolset_resolution_failure_refuses_full_default_tool_surface():
+    with patch("hermes_cli.tools_config._get_platform_tools", autospec=True,
+               side_effect=RuntimeError("disposable platform lookup failure")):
+        with pytest.raises(RuntimeError, match="refusing the full default toolset"):
+            _resolve_cron_enabled_toolsets({}, CFG)
