diff --git a/tests/cron/test_okengine_script_failure_report_only.py b/tests/cron/test_okengine_script_failure_report_only.py
new file mode 100644
index 00000000..2afa41b9
--- /dev/null
+++ b/tests/cron/test_okengine_script_failure_report_only.py
@@ -0,0 +1,68 @@
+"""A failed collection script may be reported, never repaired by cron tools."""
+
+from unittest.mock import create_autospec
+
+import cron.notepad as notepad
+import cron.scheduler as scheduler
+from cron.scheduler_prompt import _build_job_prompt
+from tests.cron.test_scheduler_completion_verification import _FakeCronAgent, _run_booked_job
+
+
+def _run_script_fire(monkeypatch, tmp_path, *, script_ok):
+    observed = []
+
+    class RecordingAgent(_FakeCronAgent):
+        def __init__(self, *args, **kwargs):
+            observed.append(kwargs)
+
+    monkeypatch.setattr(
+        scheduler, "_run_job_script_with_claim_heartbeat",
+        lambda *_a, **_k: (script_ok, "collection script failed" if not script_ok else "data ready"),
+    )
+    _run_booked_job(
+        monkeypatch, tmp_path,
+        job={"id": "report-script", "name": "Report script", "prompt": "Report collection result",
+             "script": "disposable-script.sh", "model": "fixture-model",
+             "enabled_toolsets": ["terminal", "file", "code_execution"],
+             "schedule_display": "manual"},
+        agent_type=RecordingAgent,
+    )
+    assert len(observed) == 1
+    return observed[0]
+
+
+def test_failed_script_report_agent_has_no_tools(monkeypatch, tmp_path):
+    kwargs = _run_script_fire(monkeypatch, tmp_path, script_ok=False)
+    assert kwargs["enabled_toolsets"] == [], (
+        "failed-script reporting must have zero tools even when the job requested mutating ones")
+
+
+def test_successful_script_retains_requested_toolsets(monkeypatch, tmp_path):
+    kwargs = _run_script_fire(monkeypatch, tmp_path, script_ok=True)
+    assert kwargs["enabled_toolsets"] == ["terminal", "file", "code_execution"]
+
+
+def test_empty_successful_script_skips_agent_prompt_without_reexecution(monkeypatch):
+    monkeypatch.setattr(
+        notepad, "render_notepad_section",
+        create_autospec(notepad.render_notepad_section, return_value=""),
+    )
+    prompt = _build_job_prompt(
+        {"id": "empty-collection", "prompt": "Report data", "script": "missing-script.sh"},
+        prerun_script=(True, ""),
+    )
+
+    assert prompt is None, "a successful empty collection has nothing for the agent to report"
+
+
+def test_run_context_is_added_only_to_effective_prompt(monkeypatch):
+    monkeypatch.setattr(
+        notepad, "render_notepad_section",
+        create_autospec(notepad.render_notepad_section, return_value=""),
+    )
+    job = {"id": "context-fire", "prompt": "Summarize current results"}
+
+    assembled = _build_job_prompt(job, extra_prompt="Current run is a manual audit")
+
+    assert "## Run Context\nCurrent run is a manual audit" in assembled
+    assert job["prompt"] == "Summarize current results", "run context must not persist on the job"
