diff --git a/tests/cron/test_okengine_receipt_hint.py b/tests/cron/test_okengine_receipt_hint.py
new file mode 100644
index 000000000..6a25c522e
--- /dev/null
+++ b/tests/cron/test_okengine_receipt_hint.py
@@ -0,0 +1,39 @@
+"""Per-selected-item guidance must not weaken cron's hard receipt gate."""
+
+import pytest
+
+from cron.scheduler_prompt import _build_job_prompt
+
+
+def test_receipt_job_prompt_forbids_silence_for_selected_work_and_keeps_recursion_rule():
+    job = {
+        "id": "receipt-fixture",
+        "prompt": "Selected items: alpha and beta. Report both dispositions.",
+        "output_contract": {"completion": "per-selected-item"},
+    }
+
+    prompt = _build_job_prompt(job)
+
+    assert "If this run selected work, [SILENT] is forbidden" in prompt
+    assert "disposition for every selected item" in prompt
+    assert "exact fenced okengine receipt" in prompt
+    assert "respond with exactly \"[SILENT]\"" not in prompt
+    assert "NEVER create or update a cron job" in prompt
+    assert prompt.endswith(job["prompt"])
+
+
+@pytest.mark.parametrize(
+    "contract",
+    [None, {}, [], "per-selected-item", {"completion": None}, {"completion": "summary"}],
+)
+def test_nonreceipt_or_malformed_contract_keeps_original_generic_silence_guidance(contract):
+    job = {"id": "generic-fixture", "prompt": "Check for new work"}
+    if contract is not None:
+        job["output_contract"] = contract
+
+    prompt = _build_job_prompt(job)
+
+    assert "respond with exactly \"[SILENT]\"" in prompt
+    assert "RECEIPT: This job has a per-selected-item" not in prompt
+    assert "NEVER create or update a cron job" in prompt
+    assert prompt.endswith(job["prompt"])
