+# OKEngine #190: opt-in keyed search rotation, preserving the carried default
+# cohort. Paid xAI and keyless-only providers do not join this ring.
+_OKENGINE_ROTATE_LEGACY_ORDER = (
+    "tavily", "exa", "parallel", "firecrawl", "searxng", "brave-free", "ddgs")
+_OKENGINE_ROTATE_I = -1
+_OKENGINE_ROTATE_LOCK = threading.Lock()
+
+
+def _okengine_rotate_candidates(capability: str) -> list[str]:
+    """Admitted, currently usable provider names for search or extraction."""
+    names = list(_OKENGINE_ROTATE_LEGACY_ORDER)
+    for provider in _list_registered_web_providers():
+        name = getattr(provider, "name", "")
+        if name and name != "xai" and name not in _LEGACY_WEB_BACKENDS and name not in names:
+            names.append(name)
+    result = []
+    method = "supports_search" if capability == "search" else "supports_extract"
+    for name in names:
+        if not _is_backend_available(name):
+            continue
+        provider = _registered_web_provider(name)
+        if provider is not None and _probe(provider, method):
+            result.append(name)
+    return result
+
+
+def _okengine_rotate_search_backend() -> str:
+    """Advance once per search call, serializing concurrent gateway workers."""
+    global _OKENGINE_ROTATE_I
+    available = _okengine_rotate_candidates("search")
+    if not available:
+        return "firecrawl"  # explicit unavailable selection surfaces a typed vendor error
+    with _OKENGINE_ROTATE_LOCK:
+        _OKENGINE_ROTATE_I = (_OKENGINE_ROTATE_I + 1) % len(available)
+        return available[_OKENGINE_ROTATE_I]
+
+
+def _okengine_rotate_extract_backend() -> str:
+    """A shared search ring cannot pass a search-only provider to web_extract."""
+    available = _okengine_rotate_candidates("extract")
+    return available[0] if available else "firecrawl"
+
+
 def _get_search_backend() -> str:
     """Backend for web_search: ``web.search_backend`` (strict, no probe) > ``web.backend`` > autodetect."""
-    return _configured_backend("search_backend") or _get_backend()
+    specific = _configured_backend("search_backend")
+    if specific == "rotate" or (not specific and _configured_backend() == "rotate"):
+        return _okengine_rotate_search_backend()
+    return specific or _get_backend()
 
 
