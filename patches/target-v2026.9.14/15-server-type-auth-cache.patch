+def _server_type_probe_cache_key(server_url: str, api_key: object) -> Optional[str]:
+    """Keep a local capability verdict scoped to the credential that observed it.
+
+    A callable key can mint different values per call, so it has no safe stable
+    cache identity. String keys use only a non-reversible digest, never the
+    credential itself, in either the in-memory or disk memo.
+    """
+    if not isinstance(api_key, str):
+        return None
+    from agent.credential_persistence import fingerprint_secret_value
+    fingerprint = fingerprint_secret_value(api_key)
+    return server_url if not fingerprint else f"{server_url}|auth={fingerprint}"
+
