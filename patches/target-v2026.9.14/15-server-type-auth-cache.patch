diff --git a/tests/agent/test_okengine_server_type_auth_scope.py b/tests/agent/test_okengine_server_type_auth_scope.py
new file mode 100644
index 00000000..e12fc609
--- /dev/null
+++ b/tests/agent/test_okengine_server_type_auth_scope.py
@@ -0,0 +1,89 @@
+"""A failed local probe under one API key cannot hide another key's server."""
+
+import httpx
+
+from agent import model_metadata as metadata
+
+
+def test_negative_server_type_cache_is_key_scoped_across_profiles(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    metadata._endpoint_probe_path_cache.clear()
+    metadata._endpoint_blackhole_cache.clear()
+    requests = []
+
+    def respond(request):
+        requests.append((request.url.path, request.headers.get("authorization")))
+        if request.headers.get("authorization") != "Bearer good-key":
+            return httpx.Response(401)
+        if request.url.path == "/api/tags":
+            return httpx.Response(200, json={"models": []})
+        return httpx.Response(404)
+
+    real_client = httpx.Client
+    monkeypatch.setattr(
+        httpx, "Client",
+        lambda **kwargs: real_client(transport=httpx.MockTransport(respond), **kwargs),
+    )
+    endpoint = "http://localserver:8123/v1"
+    assert metadata.detect_local_server_type(endpoint, api_key="bad-key") is None
+    calls_after_bad = len(requests)
+    assert metadata.detect_local_server_type(endpoint + "/", api_key="good-key") == "ollama", (
+        "a 401 under one profile must not be reused as the next profile's capability verdict")
+    assert len(requests) > calls_after_bad
+
+
+def test_positive_disk_server_type_cache_is_key_scoped_and_contains_no_secret(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    metadata._endpoint_probe_path_cache.clear()
+    metadata._endpoint_blackhole_cache.clear()
+    requests = []
+
+    def respond(request):
+        requests.append(request.headers.get("authorization"))
+        if request.headers.get("authorization") == "Bearer good-key":
+            if request.url.path == "/api/tags":
+                return httpx.Response(200, json={"models": []})
+            return httpx.Response(404)
+        return httpx.Response(401)
+
+    real_client = httpx.Client
+    monkeypatch.setattr(
+        httpx, "Client",
+        lambda **kwargs: real_client(transport=httpx.MockTransport(respond), **kwargs),
+    )
+    endpoint = "http://localserver:8124/v1"
+    assert metadata.detect_local_server_type(endpoint, api_key="good-key") == "ollama"
+    calls_after_good = len(requests)
+    metadata._endpoint_probe_path_cache.clear()  # simulate a fresh worker using the disk L2
+    assert metadata.detect_local_server_type(endpoint, api_key="bad-key") is None
+    assert len(requests) > calls_after_good, "the good-key disk result must not serve bad-key"
+    assert "good-key" not in str(metadata._endpoint_probe_path_cache)
+    disk = metadata._local_probe_disk_cache_path()
+    assert "good-key" not in disk.read_text(encoding="utf-8")
+
+
+def test_callable_probe_key_is_not_cached_across_token_rotation(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    metadata._endpoint_probe_path_cache.clear()
+    metadata._endpoint_blackhole_cache.clear()
+    requests = []
+
+    def respond(request):
+        requests.append(request.headers.get("authorization"))
+        if request.headers.get("authorization") == "Bearer good-key":
+            return (httpx.Response(200, json={"models": []})
+                    if request.url.path == "/api/tags" else httpx.Response(404))
+        return httpx.Response(401)
+
+    real_client = httpx.Client
+    monkeypatch.setattr(
+        httpx, "Client",
+        lambda **kwargs: real_client(transport=httpx.MockTransport(respond), **kwargs),
+    )
+    tokens = iter(("bad-key", "good-key"))
+    endpoint = "http://localserver:8125/v1"
+    assert metadata.detect_local_server_type(endpoint, api_key=lambda: next(tokens)) is None
+    before = len(requests)
+    assert metadata.detect_local_server_type(endpoint, api_key=lambda: next(tokens)) == "ollama"
+    assert len(requests) > before
+    assert not metadata._endpoint_probe_path_cache, "callable credentials have no stable cache identity"
