+    assert invoke_agent._todo_store.read() == todos
+    assert completed == ["todo_list"]
+
+
+def test_sequential_inline_todo_dispatch_persists_real_store_and_counts_completion(
+    invoke_agent,
+):
+    invoke_agent._context_engine_tool_names = set()
+    todos = [{"id": "sequential", "content": "Check retained receipt", "status": "pending"}]
+    ref = _ToolCallRef("todo_list", {"todos": todos}, "disposable-task", "todo-call", [])
+    completed = []
+    with capture_completed_tool_handlers(completed.append):
+        dispatch = _resolve_sequential_dispatch(invoke_agent, ref, [])
+        result = dispatch.execute(ref.args)
+    assert json.loads(result)["todos"] == todos
+    assert invoke_agent._todo_store.read() == todos
+    assert completed == ["todo_list"]
+
+
+def test_sequential_delegate_dispatch_counts_only_returned_handler(invoke_agent):
+    invoke_agent._context_engine_tool_names = set()
+    invoke_agent._should_emit_quiet_tool_messages = lambda: False
+    calls = []
+
+    def delegate(args):
+        calls.append(args)
+        if args.get("fail"):
+            raise RuntimeError("disposable delegate failure")
+        return {"accepted": args["goal"]}
+
+    invoke_agent._dispatch_delegate_task = delegate
+    ref = _ToolCallRef(
+        "delegate_task", {"goal": "selected"}, "disposable-task", "delegate-call", []
+    )
+    completed = []
+    with capture_completed_tool_handlers(completed.append):
+        dispatch = _resolve_sequential_dispatch(invoke_agent, ref, [])
+        assert dispatch.is_delegate
+        assert dispatch.execute(ref.args) == {"accepted": "selected"}
+        with pytest.raises(RuntimeError, match="disposable delegate failure"):
+            dispatch.execute({"fail": True})
+    assert calls == [{"goal": "selected"}, {"fail": True}]
+    assert completed == ["delegate_task"]
+
+
+def test_sequential_context_engine_dispatch_counts_returned_contract_handler(invoke_agent):
+    invoke_agent._should_emit_quiet_tool_messages = lambda: False
+    invoke_agent._context_engine_tool_names = {"context_probe"}
+    engine = create_autospec(ContextEngine, instance=True)
