+        lambda name, args, *, messages: json.dumps({"name": name, "args": args})
+    )
+    invoke_agent.context_compressor = engine
+    ref = _ToolCallRef(
+        "context_probe", {"key": "selected"}, "disposable-task", "context-call", []
