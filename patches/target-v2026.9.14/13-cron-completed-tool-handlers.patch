@@ -0,0 +1,47 @@
+"""Per-fire completion sink for real tool handlers, propagated with ContextVars.
+
+No sink is installed for ordinary agent turns. Cron installs one while its
+conversation runs, and worker-thread context copies carry the same callback.
+"""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+import json
+import logging
+from typing import Callable, Iterator, Optional
+
+logger = logging.getLogger(__name__)
+_completed_sink: ContextVar[Optional[Callable[[str], None]]] = ContextVar(
+    "hermes_completed_tool_handler_sink", default=None)
+
+
+@contextmanager
+def capture_completed_tool_handlers(sink: Callable[[str], None]) -> Iterator[None]:
+    token = _completed_sink.set(sink)
+    try:
+        yield
+    finally:
+        _completed_sink.reset(token)
+
+
+def record_completed_tool_handler(name: str) -> None:
+    """Record only after a concrete handler returned, never a model request."""
+    sink = _completed_sink.get()
+    if sink is None:
+        return
+    try:
+        sink(name)
+    except Exception:
+        # Telemetry must not turn a completed tool into a duplicate retry.
+        logger.exception("Completed-tool telemetry sink failed for %s", name)
+
+
+def record_completed_connector_handler(name: str, result: object) -> None:
+    """Count only a connector response, not a transport/error envelope."""
+    try:
+        envelope = json.loads(result) if isinstance(result, str) else result
+    except (TypeError, ValueError):
+        return
+    if (isinstance(envelope, dict) and "response" in envelope
+            and "error" not in envelope):
+        record_completed_tool_handler(name)
