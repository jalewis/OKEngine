@@ -0,0 +1,392 @@
+"""Completion telemetry is tied to concrete handler returns, not model intent."""
+
+import asyncio
+import concurrent.futures
+import json
+import threading
+from types import SimpleNamespace
+from unittest.mock import create_autospec, patch
+
+import pytest
+
+from agent.tool_executor import (
+    _ToolCallRef, _recording_nonregistry_call, _resolve_sequential_dispatch,
+)
+from agent.agent_runtime_helpers import invoke_tool
+from agent.context_engine import ContextEngine
+from agent.memory_manager import MemoryManager
+from tools.todo_tool import TodoStore
+from tools.registry import ToolRegistry
+from tools.thread_context import propagate_context_to_thread
+from tools.tool_execution_telemetry import (
+    capture_completed_tool_handlers, record_completed_connector_handler)
+
+
+def _schema(name):
+    return {"name": name, "description": "disposable fixture tool",
+            "parameters": {"type": "object", "properties": {}}}
+
+
+def _registry_with_probe(handler, *, is_async=False):
+    registry = ToolRegistry()
+    registry.register(
+        name="receipt_probe", toolset="fixture", schema=_schema("receipt_probe"),
+        handler=handler, is_async=is_async,
+    )
+    return registry
+
+
+def test_completed_registry_handler_is_counted_once():
+    calls = []
+
+    def handler(args, **_kwargs):
+        calls.append(args)
+        return '{"ok":true}'
+
+    registry = _registry_with_probe(handler)
+    completed = []
+    with capture_completed_tool_handlers(completed.append):
+        result = registry.dispatch("receipt_probe", {"key": "selected"})
+
+    assert json.loads(result) == {"ok": True}
+    assert calls == [{"key": "selected"}]
+    assert completed == ["receipt_probe"]
+
+
+def test_completed_handler_sink_failure_does_not_retry_tool(caplog):
+    calls = []
+
+    def handler(args, **_kwargs):
+        calls.append(args)
+        return '{"ok":true}'
+
+    def broken_sink(_name):
+        raise RuntimeError("disposable completion sink failure")
+
+    registry = _registry_with_probe(handler)
+    with capture_completed_tool_handlers(broken_sink):
+        result = registry.dispatch("receipt_probe", {"key": "selected"})
+    assert json.loads(result) == {"ok": True}
+    assert calls == [{"key": "selected"}], (
+        "telemetry failure must not cause a second concrete tool execution")
+    assert any("Completed-tool telemetry sink failed" in row.message
+               for row in caplog.records)
+
+
+def test_unknown_or_raising_tool_cannot_satisfy_completion_gate():
+    def failing_handler(_args, **_kwargs):
+        raise RuntimeError("handler failed before a result")
+
+    registry = _registry_with_probe(failing_handler)
+    completed = []
+    # The old patch would count this assistant turn merely because a call was
+    # present, even if validation supplied a synthetic error-result row.
+    messages = [{"role": "assistant", "tool_calls": [{"function": {"name": "missing"}}]}]
+    assert sum(bool(m.get("tool_calls")) for m in messages) == 1
+
+    with capture_completed_tool_handlers(completed.append):
+        missing = registry.dispatch("not_registered", {})
+        failed = registry.dispatch("receipt_probe", {})
+
+    assert "error" in json.loads(missing)
+    assert "error" in json.loads(failed)
+    assert completed == [], "neither model intent nor a non-returning handler ran to completion"
+
+
+def test_async_registry_handler_completion_is_counted():
+    async def handler(_args, **_kwargs):
+        return '{"ok":true}'
+
+    registry = _registry_with_probe(handler, is_async=True)
+    completed = []
+    with (
+        capture_completed_tool_handlers(completed.append),
+        patch("model_tools._run_async", autospec=True, side_effect=asyncio.run),
+    ):
+        result = registry.dispatch("receipt_probe", {})
+    assert json.loads(result) == {"ok": True}
+    assert completed == ["receipt_probe"]
+
+
+def test_inline_handler_counts_only_after_return():
+    completed = []
+    good = _recording_nonregistry_call("delegate_task", lambda args: {"done": args["key"]})
+
+    def fail(_args):
+        raise RuntimeError("no result")
+
+    bad = _recording_nonregistry_call("delegate_task", fail)
+    with capture_completed_tool_handlers(completed.append):
+        assert good({"key": "selected"}) == {"done": "selected"}
+        with pytest.raises(RuntimeError, match="no result"):
+            bad({})
+    assert completed == ["delegate_task"]
+
+
+def test_connector_transport_error_or_malformed_envelope_is_not_counted():
+    completed = []
+    with capture_completed_tool_handlers(completed.append):
+        record_completed_connector_handler("mcp__probe__read", '{"error":{"code":"UNAVAILABLE"}}')
+        record_completed_connector_handler("mcp__probe__read", "not json")
+        record_completed_connector_handler("mcp__probe__read", '{"response":{"content":"ok"}}')
+    assert completed == ["mcp__probe__read"], (
+        "only a dispatched connector response may be positive execution telemetry")
+
+
+def test_execute_code_dispatch_uses_caller_tool_scope_not_process_global(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    import model_tools
+
+    registry = ToolRegistry()
+    registry.register(
+        name="execute_code", toolset="fixture", schema=_schema("execute_code"),
+        handler=lambda args, **kwargs: json.dumps({
+            "args": args, "enabled_tools": kwargs.get("enabled_tools"),
+        }),
+    )
+    monkeypatch.setattr(model_tools, "registry", registry)
+    monkeypatch.setattr(model_tools, "_last_resolved_tool_names", ["write_file"])
+    ids = model_tools._CallIds(task_id="disposable-task", session_id="disposable-session")
+    completed = []
+    with capture_completed_tool_handlers(completed.append):
+        result = model_tools._execute_tool(
+            "execute_code", {"code": "noop"}, {"code": "noop"}, ids,
+            user_task=None, enabled_tools=["read_file"],
+            skip_tool_execution_middleware=True,
+        )
+
+    assert json.loads(result) == {
+        "args": {"code": "noop"}, "enabled_tools": ["read_file"],
+    }
+    assert completed == ["execute_code"]
+
+
+def test_connector_dispatch_counts_only_returned_envelope(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    import model_tools
+
+    ids = model_tools._CallIds(
+        task_id="disposable-task", session_id="disposable-session",
+        tool_call_id="disposable-call",
+    )
+    response = '{"response":{"content":"ok"}}'
+    completed = []
+    with (
+        patch("model_tools_connectors.dispatch_connector_call", autospec=True,
+              return_value=response) as connector,
+        capture_completed_tool_handlers(completed.append),
+    ):
+        result = model_tools._execute_tool(
+            "connectors__fixture__read", {"key": "selected"}, {"key": "selected"}, ids,
+            user_task="disposable request", enabled_tools=None,
+            skip_tool_execution_middleware=True,
+        )
+
+    assert result == response
+    connector.assert_called_once_with(
+        "connectors__fixture__read", {"key": "selected"}, "disposable-call")
+    assert completed == ["connectors__fixture__read"]
+
+
+def test_worker_context_carries_completion_sink_without_cross_fire_leak():
+    registry = _registry_with_probe(lambda _args, **_kwargs: '{"ok":true}')
+    completed = []
+    lock = threading.Lock()
+
+    def record(name):
+        with lock:
+            completed.append(name)
+
+    with capture_completed_tool_handlers(record):
+        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
+            futures = [pool.submit(propagate_context_to_thread(registry.dispatch),
+                                   "receipt_probe", {}) for _ in range(40)]
+            assert all(json.loads(f.result()) == {"ok": True} for f in futures)
+
+    assert len(completed) == 40, "all 40 real concurrent completions must be counted"
+    registry.dispatch("receipt_probe", {})
+    assert len(completed) == 40, "the sink must be reset after the scoped fire"
+
+
+@pytest.fixture
+def invoke_agent(tmp_path, monkeypatch):
+    import model_tools
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hermes"))
+    registry = _registry_with_probe(lambda args, **_kwargs: json.dumps({"args": args}))
+    monkeypatch.setattr(model_tools, "registry", registry)
+    agent = SimpleNamespace(
+        session_id="disposable-session", _current_turn_id="disposable-turn",
+        _current_api_request_id="disposable-api", _memory_manager=None,
+        _todo_store=TodoStore(), valid_tool_names=["receipt_probe", "todo_list"],
+        enabled_toolsets=None, disabled_toolsets=None,
+    )
+    return agent
+
+
+def test_concurrent_registry_invoke_dispatches_real_handler_and_counts_completion(invoke_agent):
+    completed = []
+    with capture_completed_tool_handlers(completed.append):
+        result = invoke_tool(
+            invoke_agent, "receipt_probe", {"key": "selected"}, "disposable-task",
+            tool_call_id="disposable-call",
+        )
+    assert json.loads(result) == {"args": {"key": "selected"}}
+    assert completed == ["receipt_probe"]
+
+
+def test_concurrent_inline_todo_invoke_persists_real_store_and_counts_completion(invoke_agent):
+    todos = [{"id": "selected", "content": "Check retained receipt", "status": "pending"}]
+    completed = []
+    with capture_completed_tool_handlers(completed.append):
+        result = invoke_tool(
+            invoke_agent, "todo_list", {"todos": todos}, "disposable-task",
+            tool_call_id="inline-call", pre_tool_block_checked=True,
+        )
