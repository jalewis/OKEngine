+"""The same cron job dict reaches receipt verification with handler telemetry."""
+
+from unittest.mock import patch
+
+from tools.registry import ToolRegistry
+
+
+def _fake_turn(*, dispatch=None):
+    def _run(self, prompt, task_id=None):
+        if dispatch is not None:
+            dispatch()
+        # A model-emitted tool call is deliberately present in both fixtures:
+        # only the positive fixture executes a real registered handler.
+        return {
+            "completed": True, "failed": False, "final_response": "done",
+            "turn_exit_reason": "", "messages": [
+                {"role": "assistant", "tool_calls": [{"function": {"name": "receipt_probe"}}]},
+                {"role": "tool", "name": "receipt_probe", "content": "fixture result"},
+            ],
+        }
+    return _run
+
+
+def _run_disposable_cron(monkeypatch, tmp_path, fake_turn):
+    import cron.scheduler as scheduler
+    from tests.cron import test_scheduler_completion_verification as existing_fixture
+
+    audits = []
+
+    def _capture_audit(self, result, error):
+        audits.append((self.job, result, error))
+
+    with (
+        patch.object(existing_fixture._FakeCronAgent, "run_conversation", autospec=True,
+                     side_effect=fake_turn),
+        patch.object(scheduler._FireAudit, "write", autospec=True,
+                     side_effect=_capture_audit),
+    ):
+        existing_fixture._run_booked_job(monkeypatch, tmp_path)
+    assert audits, "the disposable run must reach cron audit/receipt handoff"
+    return audits[0]
+
+
+def test_synthetic_assistant_tool_call_cannot_satisfy_receipt_gate(monkeypatch, tmp_path):
+    job, result, error = _run_disposable_cron(monkeypatch, tmp_path, _fake_turn())
+    assert error is None
+    assert result["messages"][0]["tool_calls"]
+    assert job["_okengine_executed_tool_calls"] == 0
+
+
+def test_completed_registered_handler_publishes_count_on_same_job(monkeypatch, tmp_path):
+    registry = ToolRegistry()
+    handler_calls = []
+
+    def handler(args, **_kwargs):
+        handler_calls.append(args)
+        return '{"ok":true}'
+
+    registry.register(
+        name="receipt_probe", toolset="fixture",
+        schema={"name": "receipt_probe", "description": "fixture",
+                "parameters": {"type": "object", "properties": {}}},
+        handler=handler,
+    )
+
+    job, _result, error = _run_disposable_cron(
+        monkeypatch, tmp_path,
+        _fake_turn(dispatch=lambda: registry.dispatch("receipt_probe", {"key": "selected"})),
+    )
+    assert error is None
+    assert handler_calls == [{"key": "selected"}]
+    assert job["_okengine_executed_tool_calls"] == 1
