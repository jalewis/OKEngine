@@ -0,0 +1,73 @@
+"""Behavioral fixtures for OKEngine's bounded cron iteration contract."""
+
+import sys
+from unittest.mock import patch
+
+import pytest
+
+from cron.scheduler import (
+    _CronJobConfig,
+    _resolve_cron_agent_setup,
+    _resolve_okengine_cron_turn_limit,
+)
+
+
+@pytest.mark.parametrize("cap", [4, 6, 10, 12, 16, 90])
+def test_explicit_job_cap_precedes_global_turn_limit(cap):
+    assert _resolve_okengine_cron_turn_limit(
+        {"max_iterations": cap}, {"agent": {"max_turns": sys.maxsize}}
+    ) == cap
+
+
+@pytest.mark.parametrize("bad", [None, False, True, 0, -1, "4", 4.0, 91, sys.maxsize, []])
+def test_malformed_or_unbounded_explicit_cap_fails_closed(bad):
+    with pytest.raises(ValueError, match="max_iterations must be a positive integer"):
+        _resolve_okengine_cron_turn_limit({"max_iterations": bad}, {})
+
+
+@pytest.mark.parametrize(
+    ("cfg", "expected"),
+    [
+        ({}, 90),
+        ({"agent": {"max_turns": 7}}, 7),
+        ({"max_turns": 8}, 8),
+        ({"agent": {"max_turns": 0}}, 90),
+        ({"agent": {"max_turns": "unlimited"}}, 90),
+        ({"agent": {"max_turns": 200}}, 90),
+        ({"agent": {"max_turns": 7}, "max_turns": 8}, 7),
+    ],
+)
+def test_uncapped_job_inherits_only_a_bounded_global_cap(cfg, expected):
+    assert _resolve_okengine_cron_turn_limit({}, cfg) == expected
+
+
+def test_real_cron_agent_setup_passes_job_cap_to_constructor_inputs():
+    job = {"id": "capped", "model": "local-probe", "max_iterations": 6}
+    jc = _CronJobConfig({"cron": {"preflight": False}}, "local-probe", {}, "")
+    runtime = {"provider": "", "api_key": "fixture-key", "base_url": None}
+
+    with patch(
+        "hermes_cli.runtime_provider.resolve_runtime_provider",
+        autospec=True,
+        return_value=runtime,
+    ) as provider, patch(
+        "tools.mcp_tool_discovery.discover_mcp_tools", autospec=True, return_value=[]
+    ):
+        setup = _resolve_cron_agent_setup(job, job["id"], "Capped job", jc)
+
+    provider.assert_called_once()
+    assert setup.blocked is None
+    assert setup.max_iterations == 6
+
+
+def test_real_cron_agent_setup_rejects_invalid_cap_before_provider_resolution():
+    job = {"id": "invalid-cap", "model": "local-probe", "max_iterations": 0}
+    jc = _CronJobConfig({"cron": {"preflight": False}}, "local-probe", {}, "")
+
+    with patch(
+        "hermes_cli.runtime_provider.resolve_runtime_provider", autospec=True
+    ) as provider:
+        with pytest.raises(ValueError, match="max_iterations must be a positive integer"):
+            _resolve_cron_agent_setup(job, job["id"], "Invalid cap", jc)
+
+    provider.assert_not_called()
