diff --git a/tests/hermes_cli/test_okengine_policy_preservation.py b/tests/hermes_cli/test_okengine_policy_preservation.py
new file mode 100644
index 0000000..74e2fa1
--- /dev/null
+++ b/tests/hermes_cli/test_okengine_policy_preservation.py
@@ -0,0 +1,46 @@
+"""OKEngine preserves explicitly selected pre-v0.21.3 operating policy."""
+
+from types import SimpleNamespace
+
+from hermes_cli import config, config_migrations
+from hermes_cli.default_soul import _LEGACY_TEMPLATE_SOULS
+
+
+def test_policy_default_migrations_do_not_expand_limits_or_shorten_windows(monkeypatch):
+    raw = {
+        "delegation": {"max_iterations": 50, "max_concurrent_children": 3},
+        "curator": {"stale_after_days": 30, "archive_after_days": 90},
+    }
+    persisted = []
+    fake = SimpleNamespace(
+        read_raw_config=lambda: raw,
+        _persist_migration=lambda value: persisted.append(value.copy()),
+    )
+    monkeypatch.setattr(config_migrations, "_cfg", lambda: fake)
+    results = {"config_added": [], "warnings": []}
+
+    for target, migration in config_migrations.MIGRATIONS:
+        if target in {36, 37, 44}:
+            migration(results, True)
+
+    assert raw == {
+        "delegation": {"max_iterations": 50, "max_concurrent_children": 3},
+        "curator": {"stale_after_days": 30, "archive_after_days": 90},
+    }
+    assert persisted == []
+
+
+def test_existing_legacy_template_soul_is_retained_byte_for_byte(tmp_path):
+    old_voice = _LEGACY_TEMPLATE_SOULS[0]
+    soul = tmp_path / "SOUL.md"
+    soul.write_text(old_voice, encoding="utf-8")
+
+    config._ensure_default_soul_md(tmp_path)
+
+    assert soul.read_text(encoding="utf-8") == old_voice
+
+
+def test_missing_soul_still_seeds_current_default(tmp_path):
+    config._ensure_default_soul_md(tmp_path)
+
+    assert (tmp_path / "SOUL.md").read_text(encoding="utf-8") == config.DEFAULT_SOUL_MD
