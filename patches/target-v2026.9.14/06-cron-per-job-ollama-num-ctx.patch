diff --git a/tests/cron/test_okengine_per_job_ollama_num_ctx.py b/tests/cron/test_okengine_per_job_ollama_num_ctx.py
new file mode 100644
index 000000000..70fc9f0f8
--- /dev/null
+++ b/tests/cron/test_okengine_per_job_ollama_num_ctx.py
@@ -0,0 +1,102 @@
+"""A cron lane's Ollama context override must reach the effective agent window."""
+
+from types import SimpleNamespace
+from unittest.mock import create_autospec
+
+import pytest
+
+from cron.scheduler import _construct_cron_agent, _CronAgentSetup
+from run_agent import AIAgent
+
+
+def _construct(job):
+    captured = []
+    agent_class = create_autospec(AIAgent, side_effect=lambda **kwargs: captured.append(kwargs))
+    setup = _CronAgentSetup(
+        model="local-model", runtime={"api_key": "local", "base_url": "http://localhost:11434/v1",
+                               "provider": "local", "requested_provider": "local"},
+        max_iterations=90, enabled_toolsets=[],
+    )
+    _construct_cron_agent(agent_class, job, {}, setup, workdir=None,
+                          session_id="cron-test", session_db=None)
+    return captured[0]
+
+
+def test_cron_job_threads_its_num_ctx_to_agent_constructor():
+    assert _construct({"ollama_num_ctx": 32768})["ollama_num_ctx"] == 32768
+
+
+def test_cron_job_without_override_leaves_agent_config_default():
+    assert _construct({})["ollama_num_ctx"] is None
+
+
+@pytest.mark.parametrize("value", [True, False, 0, -1, "32768", 32768.5, [], {}])
+def test_invalid_explicit_cron_num_ctx_fails_before_agent_creation(value):
+    with pytest.raises(ValueError, match="ollama_num_ctx"):
+        _construct({"ollama_num_ctx": value})
+
+
+def test_explicit_num_ctx_clamps_compressor_to_served_window(monkeypatch):
+    from agent.agent_init import _configure_ollama_num_ctx
+
+    changes = []
+    compressor = SimpleNamespace(context_length=131072,
+                                 update_model=lambda **kwargs: changes.append(kwargs))
+    agent = SimpleNamespace(base_url="http://localhost:11434/v1", model="local-model",
+                            api_key="local", provider="local", api_mode="chat_completions",
+                            quiet_mode=True, context_compressor=compressor)
+    monkeypatch.setattr("agent.agent_init.query_ollama_num_ctx", lambda *_a, **_k: 131072)
+    _configure_ollama_num_ctx(agent, {"ollama_num_ctx": 65536}, None, 32768)
+    assert agent._ollama_num_ctx == 32768
+    assert changes[0]["context_length"] == 32768
+
+
+def test_absent_per_job_override_preserves_model_config(monkeypatch):
+    from agent.agent_init import _configure_ollama_num_ctx
+
+    compressor = SimpleNamespace(context_length=131072, update_model=lambda **_k: None)
+    agent = SimpleNamespace(base_url=None, model="local-model", api_key="local",
+                            provider="local", api_mode="chat_completions", quiet_mode=True,
+                            context_compressor=compressor)
+    _configure_ollama_num_ctx(agent, {"ollama_num_ctx": 65536}, None, None)
+    assert agent._ollama_num_ctx == 65536
+
+
+@pytest.mark.parametrize("value", [True, 0, -1, "32768", 32768.5])
+def test_invalid_direct_agent_num_ctx_is_rejected(value):
+    from agent.agent_init import _configure_ollama_num_ctx
+
+    agent = SimpleNamespace()
+    with pytest.raises(ValueError, match="ollama_num_ctx"):
+        _configure_ollama_num_ctx(agent, {}, None, value)
+
+
+def test_real_agent_constructor_uses_per_job_window(monkeypatch):
+    import agent.context_compressor as compressor_module
+    import agent.model_metadata as metadata
+    import agent.process_bootstrap as bootstrap
+    import hermes_cli.config as config
+    import model_tools
+
+    cfg = {"agent": {}, "model": {"ollama_num_ctx": 65536}}
+    monkeypatch.setattr(model_tools, "get_tool_definitions",
+                        create_autospec(model_tools.get_tool_definitions, return_value=[]))
+    monkeypatch.setattr(model_tools, "check_toolset_requirements",
+                        create_autospec(model_tools.check_toolset_requirements, return_value={}))
+    monkeypatch.setattr(bootstrap, "OpenAI", create_autospec(bootstrap.OpenAI))
+    monkeypatch.setattr(config, "load_config",
+                        create_autospec(config.load_config, return_value=cfg))
+    monkeypatch.setattr(config, "load_config_readonly",
+                        create_autospec(config.load_config_readonly, return_value=cfg))
+    monkeypatch.setattr(metadata, "get_model_context_length",
+                        create_autospec(metadata.get_model_context_length, return_value=131072))
+    monkeypatch.setattr(compressor_module, "get_model_context_length",
+                        create_autospec(compressor_module.get_model_context_length, return_value=131072))
+    agent = AIAgent(model="local-model", api_key="local", base_url="http://localhost:11434/v1",
+                    ollama_num_ctx=32768, quiet_mode=True, skip_context_files=True,
+                    skip_memory=True)
+    try:
+        assert agent._ollama_num_ctx == 32768
+        assert agent.context_compressor.context_length == 32768
+    finally:
+        agent.close()
