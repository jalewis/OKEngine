+# okengine#484: which /props URL a given base actually answers on.
+#
+# llama.cpp builds differ: current ones serve /v1/props, older ones /props. The probe tried the
+# prefixed form FIRST every time and fell back on 404, so every metadata fetch against a /props
+# server generated a guaranteed 404 -- the inference host counted 86 in one sample window, far
+# more than the once-per-process capability ladder. Remembering the URL that worked makes the
+# 404 happen at most once per process instead of once per fetch. A base answering on neither is
+# recorded so it is not re-probed either.
+_props_url_cache: Dict[str, Any] = {}
 _endpoint_model_metadata_cache: Dict[str, Dict[str, Dict[str, Any]]] = {}
