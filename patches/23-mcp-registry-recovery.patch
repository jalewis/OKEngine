+def _record_mcp_registry_loss(agent, function_name: str, function_result: Any) -> None:
+    """Make an unrecovered MCP registry miss durable beyond context compression."""
+    if not str(function_name).startswith("mcp__"):
+        return
+    text = _multimodal_text_summary(function_result)
+    if f"Unknown tool: {function_name}" not in text:
+        return
+    losses = getattr(agent, "_okengine_mcp_registry_losses", None)
+    if losses is None:
+        losses = []
+        agent._okengine_mcp_registry_losses = losses
+    if function_name not in losses:
+        losses.append(function_name)
+        if hasattr(agent, "interrupt"):
+            try:
+                agent.interrupt(f"MCP registry integrity lost: {function_name}")
+            except Exception:
+                logger.exception("Failed to interrupt agent after MCP registry loss")
+    logger.error("MCP registry integrity lost for advertised tool %s", function_name)
+
