     return f"{MCP_TOOL_NAME_PREFIX}{safe_server}{_MCP_NAME_DELIM}{safe_tool}"
 
 
+def recover_missing_mcp_tool(tool_name: str, timeout: float = 5.0) -> bool:
+    """Republish a tool removed while its MCP transport reconnects.
+
+    Outage parking deliberately removes stale handlers from the registry. A
+    reconnect normally republishes them after tools/list, but a model can call
+    a formerly advertised tool in the interval between those two events. Give
+    that call one bounded recovery opportunity instead of returning an
+    immediate, permanent-looking ``Unknown tool`` result.
+    """
+    if not str(tool_name).startswith(MCP_TOOL_NAME_PREFIX):
+        return False
+    from tools.registry import registry
+
+    if registry.get_entry(tool_name) is not None:
+        return True
+    remainder = str(tool_name)[len(MCP_TOOL_NAME_PREFIX):]
+    safe_server, separator, _safe_tool = remainder.partition(_MCP_NAME_DELIM)
+    if not separator or not safe_server:
+        return False
+    with _lock:
+        server = next(
+            (candidate for name, candidate in _servers.items()
+             if sanitize_mcp_name_component(name) == safe_server),
+            None,
+        )
+    if server is None:
+        return False
+
+    # A completed reconnect may already have fresh discovery data but have
+    # missed its publication edge. Repair that state synchronously first.
+    if getattr(server, "session", None) is not None and getattr(server, "_tools", None):
+        server._register_discovered_tools_if_needed()
+        if registry.get_entry(tool_name) is not None:
+            logger.warning("MCP tool '%s' was republished on demand", tool_name)
+            return True
+
+    _signal_reconnect(server)
+    deadline = time.monotonic() + max(0.0, float(timeout))
+    while time.monotonic() < deadline:
+        if registry.get_entry(tool_name) is not None:
+            logger.warning("MCP tool '%s' recovered after reconnect", tool_name)
+            return True
+        time.sleep(0.05)
+    return False
+
+
