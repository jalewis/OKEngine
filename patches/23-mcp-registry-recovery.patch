+def _enforce_mcp_registry_integrity(agent, job: dict) -> None:
+    """Prevent an advertised-tool loss from becoming a clean cron outcome."""
+    losses = sorted(set(
+        getattr(agent, "_okengine_mcp_registry_losses", []) or []
+    ))
+    job["_okengine_mcp_registry_losses"] = losses
+    if losses:
+        raise RuntimeError(
+            "MCP tool registry loss after bounded recovery: " + ", ".join(losses)
